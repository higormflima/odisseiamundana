---
import { collaborationTypeLabels } from '../lib/collaborations.mjs';
const { projects, base } = Astro.props;
---
<div class="collaboration-cards">
  {projects.map((project) => (
    <article class="collaboration-card">
      <a class="collaboration-card-image" href={`${base}pt/colaboracoes/${project.collaboration_id}/`} tabindex="-1" aria-hidden="true">
        <img src={`${base}${project.cover.thumbnail ?? project.cover.src}`} alt="" loading="lazy" decoding="async" />
      </a>
      <div class="collaboration-card-copy">
        <p class="eyebrow">{project.kind === 'example' ? 'Exemplo ilustrativo · ' : ''}{project.destination} · {project.country}</p>
        <h3>{project.title}</h3>
        {project.partner && (
          <div class="collaboration-card-partner">
            {project.partner.logo && <img src={`${base}${project.partner.logo.src}`} alt={project.partner.logo.alt} loading="lazy" decoding="async" />}
            <span>Com {project.partner.name}</span>
          </div>
        )}
        {project.type && <p class="collaboration-card-type">{collaborationTypeLabels[project.type]}</p>}
        <p>{project.description}</p>
        <a class="text-link" href={`${base}pt/colaboracoes/${project.collaboration_id}/`}>Conhecer {project.kind === 'example' ? 'o exemplo' : 'o projeto'} <span aria-hidden="true">→</span></a>
      </div>
    </article>
  ))}
</div>
