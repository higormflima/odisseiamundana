---
export interface JourneyCardData {
  journeyId: string;
  title: string;
  location?: string;
  period?: string;
  duration?: string;
  summary?: string;
  image?: { src: string; alt: string };
  href: string;
}

interface Props {
  journey: JourneyCardData;
  headingLevel?: 2 | 3;
}

const { journey, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}`;
const meta = [journey.period, journey.duration].filter(Boolean).join(' · ');
---

<article class="journey-card">
  {journey.image && (
    <img class="journey-card-image" src={journey.image.src} alt={journey.image.alt} loading="lazy" decoding="async" />
  )}
  <div class="journey-card-body">
    {journey.location && <p class="journey-card-location">{journey.location}</p>}
    <Heading class="journey-card-title">{journey.title}</Heading>
    {meta && <p class="journey-card-meta">{meta}</p>}
    {journey.summary && <p class="journey-card-summary">{journey.summary}</p>}
    <a class="text-link" href={journey.href}>Explorar viagem <span aria-hidden="true">→</span></a>
  </div>
</article>

<style>
  .journey-card { background: var(--paper); }
  .journey-card-image { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; background: var(--surface); }
  .journey-card-body { padding: var(--space-4); }
  .journey-card-location { margin: 0 0 var(--space-1); color: var(--accent-dark); font-size: var(--text-xs); font-weight: 800; letter-spacing: .18em; text-transform: uppercase; }
  .journey-card-title { margin: 0 0 var(--space-1); font-family: var(--font-display); font-size: clamp(24px, 2.4vw, 30px); font-weight: 400; letter-spacing: -.015em; line-height: 1.1; }
  .journey-card-meta { margin: 0 0 var(--space-3); color: var(--muted); font-size: var(--text-sm); font-weight: 600; }
  .journey-card-summary { margin: 0 0 var(--space-4); color: #46423e; font-size: var(--text-base); line-height: 1.7; }
  .journey-card .text-link span { color: var(--nautical); }
</style>
