---
import { getEntry } from 'astro:content';
import PhotoGallery from './PhotoGallery.astro';

interface Props {
  journeyId: string;
}

const { journeyId } = Astro.props;
const journey = await getEntry('journeyMetadata', journeyId);
const gallery = journey?.data.gallery;
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const publicPath = (path: string) => `${basePath}${path.replace(/^\/+/, '')}`;
const photos = gallery?.photos?.map((photo) => ({
  ...photo,
  src: publicPath(photo.src),
  thumbnail: publicPath(photo.thumbnail),
})) ?? [];
---

{photos.length > 0 && <PhotoGallery title={gallery.title} photos={photos} />}
