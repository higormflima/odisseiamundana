---
import { getEntry } from 'astro:content';
import PhotoGallery from './PhotoGallery.astro';
import { selectMotorhomePhotos } from '../lib/motorhomePhotos.mjs';
import { readImageSizeFromSrc } from '../lib/imageSize.mjs';

interface Props {
  projectId: string;
  pageId?: string;
}

const { projectId, pageId = 'overview' } = Astro.props;
const entry = await getEntry('motorhomeProjectMetadata', projectId);
if (!entry) throw new Error(`Projeto de motorhome inexistente: ${projectId}`);
const selected = selectMotorhomePhotos(entry.data, pageId, import.meta.env.DEV);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const photos = selected.map((photo) => {
  const size = readImageSizeFromSrc(photo.src);
  if (!size) throw new Error(`Foto do motorhome ausente ou sem dimensões: ${photo.src}`);
  if (!photo.thumbnail || !readImageSizeFromSrc(photo.thumbnail)) {
    throw new Error(`Miniatura do motorhome ausente ou inválida: ${photo.photo_id}`);
  }
  return { ...photo, ...size, src: `${base}${photo.src}`, thumbnail: `${base}${photo.thumbnail}` };
});
---

{photos.length > 0 && (
  <>
    {entry.data.photo_gallery.status === 'draft' && <p class="eyebrow">Prévia local · fotos não publicadas</p>}
    <PhotoGallery title="Nossa construção em fotos" photos={photos} />
  </>
)}
