---
interface Props {
  title: string;
  description?: string;
  playlistId?: string;
  videos: { videoId: string; title: string; url: string; position: number }[];
}

const { title, description, playlistId, videos } = Astro.props;
---

<section class="video-carousel" aria-labelledby="playlist-title">
  <div class="playlist-heading">
    <div>
      <p class="eyebrow">Nossa série em vídeo</p>
      <h2 id="playlist-title">{title}</h2>
    </div>
    <div class="playlist-actions">
      {playlistId && (
        <a class="text-link" href={`https://www.youtube.com/playlist?list=${playlistId}`} target="_blank" rel="noopener noreferrer">
          Playlist completa ↗
        </a>
      )}
      <div class="playlist-controls" hidden>
        <button type="button" aria-label="Vídeos anteriores" aria-controls="project-playlist" data-playlist-previous disabled>
          <span aria-hidden="true">←</span>
        </button>
        <button type="button" aria-label="Próximos vídeos" aria-controls="project-playlist" data-playlist-next disabled>
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </div>
  {description && <p class="section-intro">{description}</p>}
  <ol id="project-playlist" class="project-playlist" role="list" aria-label="Vídeos da série" tabindex="0">
    {videos.map((video) => (
      <li id={`video-${video.videoId}`}>
        <a href={video.url} target="_blank" rel="noopener noreferrer" aria-label={`Assistir ao vídeo ${video.position}: ${video.title} (abre em nova aba)`} title={video.title}>
          <img src={`https://i.ytimg.com/vi/${video.videoId}/mqdefault.jpg`} alt="" width="320" height="180" loading="lazy" decoding="async" referrerpolicy="strict-origin-when-cross-origin" />
        </a>
      </li>
    ))}
  </ol>
</section>

<script>
  const playlist = document.querySelector<HTMLOListElement>('#project-playlist');
  const controls = document.querySelector<HTMLElement>('.playlist-controls');
  const previous = document.querySelector<HTMLButtonElement>('[data-playlist-previous]');
  const next = document.querySelector<HTMLButtonElement>('[data-playlist-next]');
  if (!playlist || !controls || !previous || !next) {
    throw new Error('Elementos de navegação da playlist não encontrados.');
  }
  const updateControls = () => {
    previous.disabled = playlist.scrollLeft <= 1;
    next.disabled = playlist.scrollLeft + playlist.clientWidth >= playlist.scrollWidth - 1;
  };
  const scrollPlaylist = (direction: number) => playlist.scrollBy({
    left: direction * playlist.clientWidth * .85,
    behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
  });
  previous.addEventListener('click', () => scrollPlaylist(-1));
  next.addEventListener('click', () => scrollPlaylist(1));
  playlist.addEventListener('scroll', updateControls, { passive: true });
  new ResizeObserver(updateControls).observe(playlist);
  updateControls();
  controls.hidden = false;
</script>

<style>
  .video-carousel { margin-top: var(--space-section); }
  h2 { margin: 0 0 var(--space-3); font: 400 clamp(30px, 4vw, 44px)/1.15 var(--font-display); letter-spacing: -.02em; }
  .playlist-heading { display: flex; justify-content: space-between; align-items: end; gap: var(--space-4); }
  .playlist-actions { display: flex; align-items: center; gap: var(--space-4); flex-shrink: 0; margin-bottom: var(--space-3); }
  .playlist-controls:not([hidden]) { display: flex; gap: var(--space-2); }
  .playlist-controls button { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 1px solid var(--line); border-radius: 50%; background: var(--paper); color: var(--ink); font-size: 22px; cursor: pointer; }
  .playlist-controls button:disabled { opacity: .35; cursor: default; }
  .playlist-controls button:not(:disabled):hover { border-color: var(--accent-dark); color: var(--accent-dark); }
  .playlist-controls button:focus-visible, .project-playlist:focus-visible, .project-playlist a:focus-visible { outline: var(--focus-outline); outline-offset: 2px; }
  .section-intro { max-width: var(--content-reading); margin-bottom: var(--space-5); color: var(--muted); font-size: 16px; line-height: 1.8; }
  .project-playlist { display: flex; gap: var(--space-3); margin: 0; padding: var(--space-1) var(--space-1) var(--space-3); list-style: none; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scroll-padding-inline: var(--space-1); scrollbar-width: thin; scrollbar-color: var(--line) transparent; }
  .project-playlist li { flex: 0 0 min(280px, 80%); min-width: 0; scroll-snap-align: start; scroll-margin-top: var(--space-4); }
  .project-playlist a { display: block; aspect-ratio: 16 / 9; background: var(--surface); }
  .project-playlist img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .project-playlist a:hover { opacity: .85; }
  .project-playlist li:target a { outline: var(--focus-outline); outline-offset: 2px; }
  @media (max-width: 700px) {
    .playlist-heading { align-items: start; flex-direction: column; gap: var(--space-2); }
    .playlist-controls:not([hidden]) { display: none; }
    .video-carousel { margin-top: var(--space-6); }
  }
</style>
