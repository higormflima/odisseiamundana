---
import {
  batteryCatalog,
  equipmentCategories,
  equipmentCatalog,
  inverterCatalog,
  solarResourceCountries,
  solarResourceDataset,
  solarResourceNoticePt,
} from '../lib/solar/catalogs.ts';

const initialBatteryProfile = batteryCatalog[0];
const brazilHsp = solarResourceCountries.find((country) => country.countryIso3 === 'BRA')?.peakSunHours ?? '';
---

<section class="solar-page" data-solar-wizard>
  <header class="solar-intro">
    <p class="eyebrow">Pré-dimensionamento para veículos</p>
    <h1>Odisseia Solar</h1>
    <p>Organize o consumo e as escolhas principais do seu sistema fotovoltaico. As estimativas são calculadas neste dispositivo.</p>
  </header>

  <div class="solar-progress">
    <ol aria-label="Etapas da configuração">
      <li data-progress-item aria-current="step"><span>01</span> Veículo</li>
      <li data-progress-item><span>02</span> Insolação</li>
      <li data-progress-item><span>03</span> Cargas</li>
      <li data-progress-item><span>04</span> Bateria</li>
      <li data-progress-item><span>05</span> Relatório</li>
    </ol>
    <p data-progress-count>Etapa 1 de 5</p>
  </div>

  <div class="solar-layout">
    <form class="solar-form" data-solar-form novalidate>
      <fieldset class="solar-step" data-step-panel="0">
        <legend tabindex="-1">Veículo e sistema</legend>
        <p class="solar-step-intro">Comece com uma configuração básica. Você poderá voltar e alterar as escolhas.</p>

        <label class="solar-field" for="solar-project-name">
          Nome do projeto (opcional)
          <input id="solar-project-name" type="text" maxlength="100" data-project-name />
        </label>

        <label class="solar-field" for="solar-vehicle-type">
          Tipo de veículo
          <select id="solar-vehicle-type" data-vehicle-type required>
            <option value="" selected disabled>Selecione uma opção</option>
            <option value="van-compact">Van compacta</option>
            <option value="van-large">Van grande</option>
            <option value="motorhome-medium">Motorhome médio</option>
            <option value="motorhome-large">Motorhome grande</option>
            <option value="truck-bus">Caminhão ou ônibus convertido</option>
            <option value="other">Outro</option>
          </select>
        </label>

        <fieldset class="solar-choice-group">
          <legend>Tensão nominal do banco</legend>
          <div class="solar-choice-cards">
            <label class="solar-choice-card">
              <input type="radio" name="systemVoltageV" value="12" checked />
              <span><strong>12 V</strong><small>Opção inicial</small></span>
            </label>
            <label class="solar-choice-card">
              <input type="radio" name="systemVoltageV" value="24" />
              <span><strong>24 V</strong><small>Compatibilidade depende dos equipamentos</small></span>
            </label>
          </div>
          <details class="solar-info">
            <summary>Como escolher entre 12 V e 24 V?</summary>
            <p>Sistemas maiores, como motorhomes de grande porte e caminhões, ou instalações com equipamentos de alto consumo, podem se beneficiar de 24 V. Para a mesma potência, uma tensão maior reduz a corrente elétrica, podendo permitir cabos de menor seção e reduzir perdas. A escolha também depende dos equipamentos e componentes disponíveis.</p>
          </details>
        </fieldset>
      </fieldset>

      <fieldset class="solar-step" data-step-panel="1" hidden>
        <legend tabindex="-1">Local e insolação</legend>
        <p class="solar-step-intro">Escolha um país com referência cadastrada ou informe manualmente as horas de sol-pico.</p>

        <label class="solar-field" for="solar-country">
          País
          <select id="solar-country" data-country>
            <option value="manual">Informar HSP manualmente</option>
            {solarResourceCountries.map((country) => (
              <option value={country.countryIso3} selected={country.countryIso3 === 'BRA'}>
                {country.countryNamePt}
              </option>
            ))}
          </select>
        </label>

        <label class="solar-field" for="solar-hsp">
          Horas de sol-pico (HSP) por dia
          <span class="solar-field-control">
            <input id="solar-hsp" data-hsp type="number" min="0.1" max="24" step="0.001" value={brazilHsp} required />
            <span>h/dia</span>
          </span>
        </label>
        <p class="solar-field-note" data-hsp-status>Referência nacional média do Brasil. O valor pode ser editado.</p>
        <details class="solar-info">
          <summary>O que significa HSP?</summary>
          <p>Horas de sol-pico representam a energia solar diária equivalente a uma hora de irradiância de 1.000 W/m². A referência nacional é uma média aproximada, não uma medição local nem uma condição sazonal.</p>
          <p>{solarResourceNoticePt}</p>
          <p>Fonte: <a href={solarResourceDataset.sourceUrl} target="_blank" rel="noopener noreferrer">{solarResourceDataset.sourceName}</a>, período de referência {solarResourceDataset.referencePeriodStartYear}–{solarResourceDataset.referencePeriodEndYear}.</p>
        </details>
      </fieldset>

      <fieldset class="solar-step" data-step-panel="2" hidden>
        <legend tabindex="-1">Equipamentos e consumo</legend>
        <p class="solar-step-intro">Inclua os equipamentos usados no veículo. O consumo de cada item aparece na base de cálculo correspondente.</p>

        <div class="solar-catalog">
          {equipmentCategories.map((category) => {
            const items = equipmentCatalog.filter((item) => item.categoryId === category.id);
            return (
              <section class="solar-category" aria-labelledby={`solar-category-${category.id}`}>
                <h3 id={`solar-category-${category.id}`}>{category.labelPt}</h3>
                {items.length ? items.map((item) => (
                  <article class="solar-equipment" data-catalog-equipment data-equipment-id={item.id} data-supported-voltages={item.applicableSystemVoltagesV.join(',')}>
                    <label class="solar-equipment-select">
                      <input type="checkbox" data-catalog-choice value={item.id} checked={item.id === 'dometic-cfx5-45'} />
                      <span>
                        <strong>{item.namePt}</strong>
                        <small>{item.defaultLoad.basis.kind === 'daily-energy' ? `${item.defaultLoad.basis.energyWhPerDay.toLocaleString('pt-BR')} Wh/dia` : 'Consumo calculado conforme o perfil'}</small>
                      </span>
                    </label>
                    <label class="solar-quantity">
                      Quantidade
                      <input type="number" min="1" step="1" value="1" data-catalog-quantity disabled={item.id !== 'dometic-cfx5-45'} />
                    </label>
                    <p class="solar-equipment-note">{item.sourceMeasurement.conditions}. Consumo diário derivado do fabricante; sem horas de uso adicionais.</p>
                    <a class="solar-source-link" href={item.source.url} target="_blank" rel="noopener noreferrer">Ver especificação do fabricante</a>
                  </article>
                )) : (
                  <p class="solar-empty-category">Sem referência de consumo publicada neste catálogo. Se conhecer os dados do equipamento, adicione-o manualmente.</p>
                )}
              </section>
            );
          })}
        </div>

        <section class="solar-custom-load" aria-labelledby="solar-custom-title">
          <h3 id="solar-custom-title">Adicionar outro equipamento</h3>
          <p>Informe os dados da ficha do equipamento ou o consumo que você já conhece. Não há horas recomendadas para itens sem uma fonte validada.</p>
          <div class="solar-custom-grid">
            <label class="solar-field" for="solar-custom-name">
              Nome do equipamento
              <input id="solar-custom-name" type="text" maxlength="80" data-custom-name />
            </label>
            <label class="solar-field" for="solar-custom-category">
              Categoria
              <select id="solar-custom-category" data-custom-category>
                {equipmentCategories.map((category) => <option value={category.id}>{category.labelPt}</option>)}
              </select>
            </label>
            <label class="solar-field" for="solar-custom-supply">
              Alimentação
              <select id="solar-custom-supply" data-custom-supply>
                <option value="dc">Corrente contínua (DC)</option>
                <option value="ac">Corrente alternada (AC)</option>
              </select>
            </label>
            <label class="solar-field" for="solar-custom-basis">
              Como informar o consumo
              <select id="solar-custom-basis" data-custom-basis>
                <option value="power-time">Potência durante o uso × horas</option>
                <option value="daily-energy">Consumo diário em Wh</option>
                <option value="average-power-24h">Potência média ao longo de 24 h</option>
                <option value="compressor-cycle">Potência e ciclo de funcionamento</option>
                <option value="current-time">Corrente DC × horas</option>
              </select>
            </label>
          </div>

          <div class="solar-custom-grid" data-basis-fields="power-time">
            <label class="solar-field">Potência durante o uso (W)<input type="number" min="0.1" step="any" data-custom-power /></label>
            <label class="solar-field">Horas de uso por dia<input type="number" min="0" max="24" step="0.1" data-custom-hours /></label>
          </div>
          <div class="solar-custom-grid" data-basis-fields="daily-energy" hidden>
            <label class="solar-field">Consumo diário (Wh/dia)<input type="number" min="0.1" step="any" data-custom-daily-energy /></label>
          </div>
          <div class="solar-custom-grid" data-basis-fields="average-power-24h" hidden>
            <label class="solar-field">Potência média contínua (W)<input type="number" min="0.1" step="any" data-custom-average-power /></label>
          </div>
          <div class="solar-custom-grid" data-basis-fields="compressor-cycle" hidden>
            <label class="solar-field">Potência enquanto funciona (W)<input type="number" min="0.1" step="any" data-custom-running-power /></label>
            <label class="solar-field">Janela de funcionamento por dia (h)<input type="number" min="0" max="24" step="0.1" data-custom-operating-hours /></label>
            <label class="solar-field">Ciclo de trabalho (%)<input type="number" min="0" max="100" step="1" data-custom-duty-cycle /></label>
          </div>
          <div class="solar-custom-grid" data-basis-fields="current-time" hidden>
            <label class="solar-field">Corrente do equipamento (A)<input type="number" min="0.1" step="any" data-custom-current /></label>
            <label class="solar-field">Tensão do equipamento
              <select data-custom-voltage><option value="12">12 V</option><option value="24">24 V</option></select>
            </label>
            <label class="solar-field">Horas de uso por dia<input type="number" min="0" max="24" step="0.1" data-custom-current-hours /></label>
          </div>
          <div class="solar-custom-grid" data-custom-ac-fields hidden>
            <label class="solar-field">Potência nominal AC (W)<input type="number" min="0.1" step="any" data-custom-rated-power /></label>
            <label class="solar-field">Potência de partida (W), se conhecida<input type="number" min="0.1" step="any" data-custom-startup-power /></label>
          </div>
          <div class="solar-custom-actions">
            <label class="solar-field solar-inline-field">Quantidade<input type="number" min="1" step="1" value="1" data-custom-quantity /></label>
            <label class="solar-checkbox"><input type="checkbox" checked data-custom-simultaneous /> Pode funcionar ao mesmo tempo que outras cargas AC</label>
            <button class="button" type="button" data-add-custom-load>Adicionar equipamento</button>
          </div>
          <p class="solar-error" data-custom-error role="alert" hidden></p>
          <ul class="solar-load-list" data-selected-loads aria-label="Equipamentos selecionados"></ul>
        </section>

        <section class="solar-inverter-settings" data-inverter-settings hidden aria-labelledby="solar-inverter-title">
          <h3 id="solar-inverter-title">Dados do inversor para cargas AC</h3>
          <p>O consumo no lado da bateria depende do inversor. Selecione uma tensão e use a referência 230 V somente se ela corresponder ao seu equipamento.</p>
          <label class="solar-field" for="solar-ac-output">
            Tensão de saída AC
            <select id="solar-ac-output" data-ac-output>
              <option value="">Selecione a tensão do seu sistema</option>
              <option value="127">127 V</option>
              <option value="220">220 V</option>
              <option value="230">230 V</option>
              <option value="120">120 V</option>
            </select>
          </label>
          <label class="solar-checkbox solar-reference-toggle" data-inverter-reference-wrap hidden>
            <input type="checkbox" data-use-victron-reference />
            Usar perfil Victron SUN de 230 V como referência editável
          </label>
          <p class="solar-reference-note" data-inverter-reference-note hidden>A eficiência informada pelo fabricante é máxima, não garantida em toda carga. O consumo em espera depende das horas de permanência ligado sem carga.</p>
          <div class="solar-custom-grid">
            <label class="solar-field">Eficiência do inversor (%)<input type="number" min="1" max="100" step="0.1" data-inverter-efficiency /></label>
            <label class="solar-field">Consumo sem carga (W)<input type="number" min="0" step="0.1" data-inverter-standby /></label>
            <label class="solar-field">Horas por dia ligado sem carga<input type="number" min="0" max="24" step="0.1" data-inverter-standby-hours /></label>
          </div>
          <p class="solar-field-note" data-inverter-status>Para 127 V, 220 V ou 120 V, informe os valores da ficha do inversor escolhido; não há perfil de referência cadastrado.</p>
        </section>
      </fieldset>

      <fieldset class="solar-step" data-step-panel="3" hidden>
        <legend tabindex="-1">Banco de baterias</legend>
        <p class="solar-step-intro">Escolha a química. A capacidade necessária usa o consumo diário e a autonomia que você definir.</p>

        <label class="solar-field" for="solar-autonomy">
          Quantos dias de autonomia você deseja?
          <input id="solar-autonomy" type="number" min="0.5" step="0.5" data-autonomy required />
        </label>
        <p class="solar-field-note">Autonomia é o período desejado sem reposição de energia solar. Não há um valor padrão para o seu perfil de uso.</p>

        <fieldset class="solar-choice-group">
          <legend>Tecnologia da bateria</legend>
          <div class="solar-choice-cards">
            <label class="solar-choice-card">
              <input type="radio" name="batteryChemistry" value="lifepo4" checked data-battery-chemistry />
              <span><strong>LiFePO₄</strong><small>Perfil de referência editável por tensão</small></span>
            </label>
            <label class="solar-choice-card">
              <input type="radio" name="batteryChemistry" value="lead-acid" data-battery-chemistry />
              <span><strong>Chumbo-ácido</strong><small>Exige dados da ficha da bateria escolhida</small></span>
            </label>
          </div>
        </fieldset>

        <section class="solar-battery-profile" data-lifepo4-panel aria-labelledby="solar-profile-title">
          <h3 id="solar-profile-title">Referência LiFePO₄</h3>
          <label class="solar-field" for="solar-battery-profile">
            Perfil compatível com a tensão escolhida
            <select id="solar-battery-profile" data-battery-profile>
              {batteryCatalog.map((profile) => (
                <option value={profile.id} selected={profile.id === initialBatteryProfile.id}>{profile.namePt}</option>
              ))}
            </select>
          </label>
          <p class="solar-field-note">A referência foi publicada para um modelo específico. Você pode ajustar os valores conforme a bateria escolhida.</p>
          <p class="solar-reference-note" data-battery-profile-note>{initialBatteryProfile.notePt} {initialBatteryProfile.depthOfDischargeBasisPt}</p>
          <a class="solar-source-link" data-battery-source href={initialBatteryProfile.sources[0].url} target="_blank" rel="noopener noreferrer">Abrir ficha técnica do perfil</a>
          <div class="solar-custom-grid solar-battery-fields">
            <label class="solar-field">Tensão nominal da bateria (V)<input type="number" min="0.1" step="0.1" value={initialBatteryProfile.parameters.nominalVoltageV} data-lfp-nominal-voltage /></label>
            <label class="solar-field">Capacidade por bateria (Ah)<input type="number" min="0.1" step="any" value={initialBatteryProfile.nominalCapacityAh} data-lfp-capacity /></label>
            <label class="solar-field">Profundidade de descarga (DoD %)<input type="number" min="0.1" max="100" step="0.1" value={initialBatteryProfile.parameters.depthOfDischarge * 100} data-lfp-dod /></label>
            <label class="solar-field">Eficiência de carga (%)<input type="number" min="0.1" max="100" step="0.1" value={initialBatteryProfile.parameters.chargeEfficiency * 100} data-lfp-charge-efficiency /></label>
            <label class="solar-field">Eficiência de descarga (%)<input type="number" min="0.1" max="100" step="0.1" value={initialBatteryProfile.parameters.dischargeEfficiency * 100} data-lfp-discharge-efficiency /></label>
            <label class="solar-field">Tensão de carga (V)<input type="number" min="0.1" step="0.1" value={initialBatteryProfile.parameters.chargeVoltageV} data-lfp-charge-voltage /></label>
            <label class="solar-field">Tensão de corte de descarga (V)<input type="number" min="0.1" step="0.1" value={initialBatteryProfile.parameters.dischargeCutoffVoltageV} data-lfp-cutoff-voltage /></label>
            <label class="solar-field">Corrente máxima de carga (A)<input type="number" min="0.1" step="any" value={initialBatteryProfile.parameters.maxChargeCurrentA} data-lfp-max-charge /></label>
            <label class="solar-field">Corrente contínua máxima de descarga (A)<input type="number" min="0.1" step="any" value={initialBatteryProfile.parameters.maxContinuousDischargeCurrentA} data-lfp-max-discharge /></label>
            <label class="solar-field">Corrente de pico máxima (A), se publicada<input type="number" min="0.1" step="any" value={initialBatteryProfile.parameters.maxPeakDischargeCurrentA} data-lfp-max-peak /></label>
          </div>
        </section>

        <section class="solar-battery-profile" data-lead-acid-panel hidden aria-labelledby="solar-lead-acid-title">
          <h3 id="solar-lead-acid-title">Dados da bateria chumbo-ácido</h3>
          <p>Não há eficiências genéricas cadastradas. Consulte a ficha do seu modelo; AGM, GEL e baterias inundadas não devem ser tratadas como idênticas.</p>
          <div class="solar-custom-grid solar-battery-fields">
            <label class="solar-field">Tensão nominal de cada bateria (V)
              <select data-lead-unit-voltage><option value="12">12 V</option><option value="24">24 V</option></select>
            </label>
            <label class="solar-field">Capacidade por bateria (Ah)<input type="number" min="0.1" step="any" data-lead-capacity /></label>
            <label class="solar-field">Profundidade de descarga (DoD %)<input type="number" min="0.1" max="100" step="0.1" data-lead-dod /></label>
            <label class="solar-field">Eficiência de carga (%)<input type="number" min="0.1" max="100" step="0.1" data-lead-charge-efficiency /></label>
            <label class="solar-field">Eficiência de descarga (%)<input type="number" min="0.1" max="100" step="0.1" data-lead-discharge-efficiency /></label>
            <label class="solar-field">Tensão de carga do banco (V)<input type="number" min="0.1" step="0.1" data-lead-charge-voltage /></label>
            <label class="solar-field">Tensão de corte do banco (V)<input type="number" min="0.1" step="0.1" data-lead-cutoff-voltage /></label>
            <label class="solar-field">Corrente máxima de carga (A), se publicada<input type="number" min="0.1" step="any" data-lead-max-charge /></label>
            <label class="solar-field">Corrente contínua máxima de descarga (A), se publicada<input type="number" min="0.1" step="any" data-lead-max-discharge /></label>
          </div>
        </section>
        <p class="solar-error" data-battery-error role="alert" hidden></p>
      </fieldset>

      <fieldset class="solar-step" data-step-panel="4" hidden>
        <legend tabindex="-1">Relatório técnico</legend>
        <p class="solar-step-intro">Revise os resultados, as premissas e os dados que ainda precisam ser confirmados.</p>
        <div class="solar-report-actions" role="group" aria-label="Exportar ou importar o projeto">
          <button class="button" type="button" data-print-report>Imprimir / salvar PDF</button>
          <button class="button button-secondary" type="button" data-export-project>Salvar projeto JSON</button>
          <button class="button button-secondary solar-import-button" type="button" data-import-trigger>Importar projeto JSON</button>
          <input type="file" accept=".json,application/json" data-import-project hidden />
        </div>
        <p class="solar-file-status" data-project-file-status role="status" aria-live="polite"></p>

        <article class="solar-report" data-report-content>
          <header class="solar-report-header">
            <p class="eyebrow">Odisseia Mundana · Odisseia Solar</p>
            <h2 data-report-title>Pré-dimensionamento do sistema</h2>
            <dl class="solar-report-identification">
              <div><dt>Projeto</dt><dd data-report-project-name>—</dd></div>
              <div><dt>Veículo</dt><dd data-report-vehicle>—</dd></div>
              <div><dt>Banco</dt><dd data-report-system>—</dd></div>
              <div><dt>Local / HSP</dt><dd data-report-sun>—</dd></div>
              <div><dt>Gerado em</dt><dd data-report-generated>—</dd></div>
              <div><dt>Versão</dt><dd data-report-version>—</dd></div>
            </dl>
          </header>

          <section class="solar-report-section">
            <h3>1. Resumo executivo</h3>
            <dl class="solar-report-metrics" data-report-summary></dl>
          </section>

          <section class="solar-report-section">
            <h3>2. Inventário de cargas</h3>
            <div class="solar-report-table-wrap">
              <table class="solar-report-table">
                <thead><tr><th>Equipamento</th><th>Categoria</th><th>Qtd.</th><th>Base de consumo</th><th>Energia diária</th><th>Origem do valor</th></tr></thead>
                <tbody data-report-loads></tbody>
              </table>
            </div>
            <p class="solar-report-note" data-report-excluded-loads></p>
          </section>

          <section class="solar-report-section">
            <h3>3. Dimensionamento das baterias</h3>
            <dl class="solar-report-metrics" data-report-battery></dl>
          </section>

          <section class="solar-report-section">
            <h3>4. Dimensionamento fotovoltaico</h3>
            <dl class="solar-report-metrics" data-report-pv></dl>
          </section>

          <section class="solar-report-section">
            <h3>5. Controlador, inversor e carregadores</h3>
            <dl class="solar-report-metrics" data-report-components></dl>
          </section>

          <section class="solar-report-section">
            <h3>6. Cabos e proteções</h3>
            <div class="solar-report-table-wrap">
              <table class="solar-report-table">
                <thead><tr><th>Circuito</th><th>Status</th></tr></thead>
                <tbody data-report-circuits></tbody>
              </table>
            </div>
            <p class="solar-report-note">Não são informadas seções de cabos nem correntes nominais de fusíveis/disjuntores sem os dados de instalação e validação normativa necessários.</p>
          </section>

          <section class="solar-report-section">
            <h3>7. Memória de cálculo, considerações e avisos</h3>
            <ul data-report-calculation-notes></ul>
            <ul class="solar-report-warnings" data-report-warnings></ul>
            <p class="solar-report-disclaimer">Este documento é um pré-dimensionamento, não um projeto executivo. A instalação deve ser verificada por profissional qualificado e atender às normas aplicáveis no local de utilização, além das fichas dos equipamentos e das condições reais de montagem.</p>
          </section>
        </article>
      </fieldset>

      <nav class="solar-step-actions" aria-label="Navegação da configuração">
        <button class="button button-secondary" type="button" data-step-back disabled>Voltar</button>
        <p data-step-status role="status" aria-live="polite"></p>
        <button class="button" type="button" data-step-next>Continuar</button>
      </nav>
    </form>

    <aside class="solar-summary" aria-labelledby="solar-summary-title">
      <p class="eyebrow">Resumo atualizado</p>
      <h2 id="solar-summary-title">Seu sistema</h2>
      <dl>
        <div><dt>Veículo</dt><dd data-summary-vehicle>Aguardando seleção</dd></div>
        <div><dt>Banco</dt><dd data-summary-voltage>12 V</dd></div>
        <div><dt>Local / HSP</dt><dd data-summary-sun>Brasil · 5,015 h/dia</dd></div>
        <div><dt>Consumo diário estimado</dt><dd data-summary-energy>Selecione as cargas</dd></div>
        <div><dt>Capacidade nominal necessária</dt><dd data-summary-capacity>Defina consumo, autonomia e bateria</dd></div>
        <div><dt>Quantidade por capacidade</dt><dd data-summary-battery-count>—</dd></div>
      </dl>
      <p class="solar-summary-status" data-summary-status role="status" aria-live="polite">As estimativas aparecem conforme você preenche os dados.</p>
      <p class="solar-summary-note" data-summary-note></p>
      <p class="solar-next-stage">O relatório apresenta os resultados calculáveis e identifica os dimensionamentos que ainda dependem de dados técnicos.</p>
    </aside>
  </div>

  <aside class="solar-disclaimer" role="note">
    <strong>Importante:</strong> os resultados são estimativas de pré-dimensionamento baseadas nos dados informados e nos parâmetros de referência. A instalação deve ser verificada por profissional qualificado e atender às normas aplicáveis no local de utilização.
  </aside>

  <noscript><p class="solar-noscript">Ative o JavaScript do navegador para usar o assistente. Os cálculos são feitos localmente e os dados não são enviados a um servidor.</p></noscript>
</section>

<script>
  import type { BatteryParameters, ElectricalLoad } from '../lib/solar/calculations.ts';
  import {
    batteryCatalog,
    equipmentCategories,
    equipmentCatalog,
    inverterCatalog,
    solarResourceDataset,
    solarResourceCountries,
  } from '../lib/solar/catalogs.ts';
  import {
    calculateBatteryCapacity,
    calculateDailyConsumption,
  } from '../lib/solar/calculations.ts';
  import { buildSolarReport } from '../lib/solar/report.ts';
  import {
    validateSolarProjectFile,
  } from '../lib/solar/project-file.ts';
  import type {
    SolarProjectBatteryFields,
    SolarProjectConfiguration,
    SolarProjectFile,
  } from '../lib/solar/project-file.ts';

  const solarApplicationVersion = '0.1.0';
  const root = document.querySelector<HTMLElement>('[data-solar-wizard]');
  if (root) {
    const get = <T extends HTMLElement>(selector: string): T => {
      const element = root.querySelector<T>(selector);
      if (!element) throw new Error(`Elemento obrigatório não encontrado: ${selector}`);
      return element;
    };
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-step-panel]'));
    const progressItems = Array.from(root.querySelectorAll<HTMLElement>('[data-progress-item]'));
    const stepStatus = get<HTMLElement>('[data-step-status]');
    const customLoads: Array<{ name: string; categoryId: string; load: ElectricalLoad }> = [];
    let activeStep = 0;
    let customLoadNumber = 0;

    const format = (value: number, maximumFractionDigits = 1) =>
      new Intl.NumberFormat('pt-BR', { maximumFractionDigits }).format(value);
    const numeric = (selector: string): number | undefined => {
      const raw = get<HTMLInputElement | HTMLSelectElement>(selector).value.trim();
      if (!raw) return undefined;
      const value = Number(raw);
      return Number.isFinite(value) ? value : undefined;
    };
    const systemVoltage = (): 12 | 24 =>
      get<HTMLInputElement>('input[name="systemVoltageV"]:checked').value === '24' ? 24 : 12;
    const selectedChemistry = (): 'lead-acid' | 'lifepo4' =>
      get<HTMLInputElement>('input[name="batteryChemistry"]:checked').value === 'lead-acid' ? 'lead-acid' : 'lifepo4';

    function setPanel(panelIndex: number) {
      activeStep = panelIndex;
      panels.forEach((panel, index) => {
        panel.hidden = index !== activeStep;
      });
      progressItems.forEach((item, index) => {
        if (index === activeStep) item.setAttribute('aria-current', 'step');
        else item.removeAttribute('aria-current');
      });
      get<HTMLElement>('[data-progress-count]').textContent = `Etapa ${activeStep + 1} de ${panels.length}`;
      get<HTMLButtonElement>('[data-step-back]').disabled = activeStep === 0;
      get<HTMLButtonElement>('[data-step-next]').hidden = activeStep === panels.length - 1;
      get<HTMLButtonElement>('[data-step-next]').textContent =
        activeStep === panels.length - 2 ? 'Gerar relatório' : 'Continuar';
      stepStatus.textContent = '';
      updateSummary();
      if (activeStep === panels.length - 1) renderReport();
      if (activeStep > 0) panels[activeStep].querySelector<HTMLElement>('legend')?.focus();
    }

    function validatePanel(): boolean {
      const panel = panels[activeStep];
      const fields = Array.from(panel.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea'));
      const invalid = fields.find((field) => !field.disabled && !field.checkValidity());
      if (invalid) {
        invalid.reportValidity();
        return false;
      }
      if (activeStep === 2 && getCompatibleLoads().length === 0) {
        stepStatus.textContent = 'Adicione ao menos uma carga compatível com a tensão escolhida para calcular o consumo.';
        return false;
      }
      return true;
    }

    function getCompatibleLoads(): ElectricalLoad[] {
      const voltage = systemVoltage();
      const catalogLoads = equipmentCatalog.flatMap((item) => {
        const card = root.querySelector<HTMLElement>(`[data-equipment-id="${item.id}"]`);
        const choice = card?.querySelector<HTMLInputElement>('[data-catalog-choice]');
        const quantity = card?.querySelector<HTMLInputElement>('[data-catalog-quantity]');
        if (!choice?.checked || !item.applicableSystemVoltagesV.includes(voltage) || !quantity) return [];
        return [{ ...item.defaultLoad, quantity: Number(quantity.value) }];
      });
      return [...catalogLoads, ...customLoads.map(({ load }) => load)];
    }

    function renderSelectedLoads() {
      const list = get<HTMLUListElement>('[data-selected-loads]');
      list.replaceChildren();
      for (const item of equipmentCatalog) {
        const card = root.querySelector<HTMLElement>(`[data-equipment-id="${item.id}"]`);
        const choice = card?.querySelector<HTMLInputElement>('[data-catalog-choice]');
        if (!choice?.checked) continue;
        const li = document.createElement('li');
        const text = document.createElement('span');
        text.textContent = item.namePt;
        li.append(text);
        if (!item.applicableSystemVoltagesV.includes(systemVoltage())) {
          const note = document.createElement('small');
          note.textContent = `Não incluída: referência disponível para ${item.applicableSystemVoltagesV.join('/')} V.`;
          li.append(note);
        }
        list.append(li);
      }
      customLoads.forEach((entry, index) => {
        const li = document.createElement('li');
        const text = document.createElement('span');
        text.textContent = entry.name;
        const quantityLabel = document.createElement('label');
        quantityLabel.textContent = 'Quantidade ';
        const quantityInput = document.createElement('input');
        quantityInput.type = 'number';
        quantityInput.min = '1';
        quantityInput.step = '1';
        quantityInput.value = String(entry.load.quantity);
        quantityInput.setAttribute('aria-label', `Quantidade de ${entry.name}`);
        quantityInput.addEventListener('input', () => {
          entry.load.quantity = Number(quantityInput.value);
          updateSummary();
        });
        quantityLabel.append(quantityInput);
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'solar-remove-load';
        remove.textContent = 'Remover';
        remove.setAttribute('aria-label', `Remover ${entry.name}`);
        remove.addEventListener('click', () => {
          customLoads.splice(index, 1);
          renderSelectedLoads();
          updateInverterFields();
          updateSummary();
        });
        li.append(text, quantityLabel, remove);
        list.append(li);
      });
    }

    function updateCatalogChoices() {
      const voltage = systemVoltage();
      equipmentCatalog.forEach((item) => {
        const card = root.querySelector<HTMLElement>(`[data-equipment-id="${item.id}"]`);
        const choice = card?.querySelector<HTMLInputElement>('[data-catalog-choice]');
        const quantity = card?.querySelector<HTMLInputElement>('[data-catalog-quantity]');
        if (!choice || !quantity) return;
        const compatible = item.applicableSystemVoltagesV.includes(voltage);
        choice.disabled = !compatible;
        quantity.disabled = !compatible || !choice.checked;
      });
      renderSelectedLoads();
    }

    function updateHsp() {
      const country = get<HTMLSelectElement>('[data-country]').value;
      const hsp = get<HTMLInputElement>('[data-hsp]');
      const countryRecord = solarResourceCountries.find((item) => item.countryIso3 === country);
      if (country === 'manual') {
        hsp.value = '';
        get<HTMLElement>('[data-hsp-status]').textContent = 'Informe a HSP de uma fonte ou local de referência. O aplicativo não estima esse valor.';
      } else if (countryRecord) {
        hsp.value = String(countryRecord.peakSunHours);
        get<HTMLElement>('[data-hsp-status]').textContent = 'Média nacional anual do catálogo; editável e não representativa de todo local ou estação.';
      }
      updateSummary();
    }

    function updateCustomBasis() {
      const basis = get<HTMLSelectElement>('[data-custom-basis]').value;
      root.querySelectorAll<HTMLElement>('[data-basis-fields]').forEach((group) => {
        const visible = group.dataset.basisFields === basis;
        group.hidden = !visible;
        group.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select').forEach((field) => {
          field.disabled = !visible;
        });
      });
      const supply = get<HTMLSelectElement>('[data-custom-supply]').value;
      const currentTimeOption = get<HTMLSelectElement>('[data-custom-basis]').querySelector<HTMLOptionElement>('option[value="current-time"]');
      if (currentTimeOption) currentTimeOption.disabled = supply === 'ac';
      if (supply === 'ac' && basis === 'current-time') get<HTMLSelectElement>('[data-custom-basis]').value = 'power-time';
      const acFields = get<HTMLElement>('[data-custom-ac-fields]');
      acFields.hidden = supply !== 'ac';
      acFields.querySelectorAll<HTMLInputElement>('input').forEach((field) => {
        field.disabled = supply !== 'ac';
      });
    }

    function addCustomLoad() {
      const name = get<HTMLInputElement>('[data-custom-name]').value.trim();
      const supply = get<HTMLSelectElement>('[data-custom-supply]').value as 'dc' | 'ac';
      const basisKind = get<HTMLSelectElement>('[data-custom-basis]').value;
      const quantity = numeric('[data-custom-quantity]');
      const error = get<HTMLElement>('[data-custom-error]');
      let basis: ElectricalLoad['basis'] | undefined;
      const power = numeric('[data-custom-power]');
      const hours = numeric('[data-custom-hours]');
      const energy = numeric('[data-custom-daily-energy]');
      const averagePower = numeric('[data-custom-average-power]');
      const runningPower = numeric('[data-custom-running-power]');
      const operatingHours = numeric('[data-custom-operating-hours]');
      const dutyCycle = numeric('[data-custom-duty-cycle]');
      const current = numeric('[data-custom-current]');
      const currentHours = numeric('[data-custom-current-hours]');
      const currentVoltage = Number(get<HTMLSelectElement>('[data-custom-voltage]').value);

      if (basisKind === 'power-time' && power !== undefined && hours !== undefined && power > 0 && hours >= 0 && hours <= 24) {
        basis = { kind: 'power-time', powerW: power, hoursPerDay: hours };
      } else if (basisKind === 'daily-energy' && energy !== undefined && energy > 0) {
        basis = { kind: 'daily-energy', energyWhPerDay: energy };
      } else if (basisKind === 'average-power-24h' && averagePower !== undefined && averagePower > 0) {
        basis = { kind: 'average-power-24h', averagePowerW: averagePower };
      } else if (basisKind === 'compressor-cycle'
        && runningPower !== undefined && runningPower > 0
        && operatingHours !== undefined && operatingHours >= 0 && operatingHours <= 24
        && dutyCycle !== undefined && dutyCycle >= 0 && dutyCycle <= 100) {
        basis = { kind: 'compressor-cycle', runningPowerW: runningPower, operatingWindowHoursPerDay: operatingHours, dutyCycle: dutyCycle / 100 };
      } else if (basisKind === 'current-time'
        && supply === 'dc' && current !== undefined && current > 0
        && currentHours !== undefined && currentHours >= 0 && currentHours <= 24) {
        basis = { kind: 'current-time', currentA: current, voltageV: currentVoltage, hoursPerDay: currentHours };
      }

      const ratedPowerW = numeric('[data-custom-rated-power]');
      const startupPowerW = numeric('[data-custom-startup-power]');
      if (!name || quantity === undefined || !Number.isInteger(quantity) || quantity < 1 || !basis
        || (supply === 'ac' && (ratedPowerW === undefined || ratedPowerW <= 0))
        || (startupPowerW !== undefined && startupPowerW <= 0)) {
        error.textContent = 'Preencha o nome, a quantidade e os valores necessários para a base de consumo escolhida.';
        error.hidden = false;
        return;
      }

      const load: ElectricalLoad = {
        id: `custom-load-${++customLoadNumber}`,
        supply,
        quantity,
        simultaneous: get<HTMLInputElement>('[data-custom-simultaneous]').checked,
        basis,
        ...(supply === 'ac' && ratedPowerW !== undefined ? { ratedPowerW } : {}),
        ...(supply === 'ac' && startupPowerW !== undefined ? { startupPowerW } : {}),
      };
      try {
        calculateDailyConsumption([load], systemVoltage(), 1, 0, 0);
      } catch (calculationError) {
        if (!(calculationError instanceof TypeError || calculationError instanceof RangeError)) throw calculationError;
        error.textContent = calculationError.message;
        error.hidden = false;
        return;
      }
      customLoads.push({
        name,
        categoryId: get<HTMLSelectElement>('[data-custom-category]').value,
        load,
      });
      error.hidden = true;
      get<HTMLInputElement>('[data-custom-name]').value = '';
      renderSelectedLoads();
      updateInverterFields();
      updateSummary();
    }

    function profileForCurrentVoltage() {
      return batteryCatalog.find((profile) => profile.systemVoltageV === systemVoltage()) ?? batteryCatalog[0];
    }

    function applyLifepo4Profile(profileId: string) {
      const profile = batteryCatalog.find((item) => item.id === profileId);
      if (!profile) throw new Error(`Perfil de bateria não encontrado: ${profileId}`);
      get<HTMLSelectElement>('[data-battery-profile]').value = profile.id;
      get<HTMLInputElement>('[data-lfp-nominal-voltage]').value = String(profile.parameters.nominalVoltageV);
      get<HTMLInputElement>('[data-lfp-capacity]').value = String(profile.nominalCapacityAh);
      get<HTMLInputElement>('[data-lfp-dod]').value = String(profile.parameters.depthOfDischarge * 100);
      get<HTMLInputElement>('[data-lfp-charge-efficiency]').value = String(profile.parameters.chargeEfficiency * 100);
      get<HTMLInputElement>('[data-lfp-discharge-efficiency]').value = String(profile.parameters.dischargeEfficiency * 100);
      get<HTMLInputElement>('[data-lfp-charge-voltage]').value = String(profile.parameters.chargeVoltageV);
      get<HTMLInputElement>('[data-lfp-cutoff-voltage]').value = String(profile.parameters.dischargeCutoffVoltageV);
      get<HTMLInputElement>('[data-lfp-max-charge]').value = String(profile.parameters.maxChargeCurrentA ?? '');
      get<HTMLInputElement>('[data-lfp-max-discharge]').value = String(profile.parameters.maxContinuousDischargeCurrentA ?? '');
      get<HTMLInputElement>('[data-lfp-max-peak]').value = String(profile.parameters.maxPeakDischargeCurrentA ?? '');
      get<HTMLElement>('[data-battery-profile-note]').textContent = `${profile.notePt} ${profile.depthOfDischargeBasisPt}`;
      const source = get<HTMLAnchorElement>('[data-battery-source]');
      source.href = profile.sources[0].url;
      source.textContent = `Abrir ficha técnica do perfil ${profile.namePt}`;
    }

    function updateBatteryChoice() {
      const isLifepo4 = selectedChemistry() === 'lifepo4';
      const lifepo4Panel = get<HTMLElement>('[data-lifepo4-panel]');
      const leadAcidPanel = get<HTMLElement>('[data-lead-acid-panel]');
      const profileSelect = get<HTMLSelectElement>('[data-battery-profile]');
      const compatibleProfile = profileForCurrentVoltage();
      Array.from(profileSelect.options).forEach((option) => {
        const profile = batteryCatalog.find((item) => item.id === option.value);
        option.disabled = Boolean(profile && profile.systemVoltageV !== systemVoltage());
      });
      if (isLifepo4 && profileSelect.value !== compatibleProfile.id) {
        applyLifepo4Profile(compatibleProfile.id);
      }
      lifepo4Panel.hidden = !isLifepo4;
      leadAcidPanel.hidden = isLifepo4;
      lifepo4Panel.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select').forEach((field) => {
        field.disabled = !isLifepo4;
      });
      leadAcidPanel.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select').forEach((field) => {
        field.disabled = isLifepo4;
      });
      [
        '[data-lfp-nominal-voltage]', '[data-lfp-capacity]', '[data-lfp-dod]',
        '[data-lfp-charge-efficiency]', '[data-lfp-discharge-efficiency]',
        '[data-lfp-charge-voltage]', '[data-lfp-cutoff-voltage]',
      ].forEach((selector) => { get<HTMLInputElement>(selector).required = isLifepo4; });
      [
        '[data-lead-unit-voltage]', '[data-lead-capacity]', '[data-lead-dod]',
        '[data-lead-charge-efficiency]', '[data-lead-discharge-efficiency]',
        '[data-lead-charge-voltage]', '[data-lead-cutoff-voltage]',
      ].forEach((selector) => {
        const field = get<HTMLInputElement | HTMLSelectElement>(selector);
        field.required = !isLifepo4;
      });
      const unitVoltage = get<HTMLSelectElement>('[data-lead-unit-voltage]');
      Array.from(unitVoltage.options).forEach((option) => {
        option.disabled = Number(option.value) > systemVoltage();
      });
      if (Number(unitVoltage.value) > systemVoltage()) unitVoltage.value = String(systemVoltage());
      updateSummary();
    }

    function updateInverterFields() {
      const hasAcLoads = getCompatibleLoads().some((load) => load.supply === 'ac');
      const settings = get<HTMLElement>('[data-inverter-settings]');
      settings.hidden = !hasAcLoads;
      const outputVoltage = get<HTMLSelectElement>('[data-ac-output]');
      const referenceWrap = get<HTMLElement>('[data-inverter-reference-wrap]');
      const referenceNote = get<HTMLElement>('[data-inverter-reference-note]');
      const useReference = get<HTMLInputElement>('[data-use-victron-reference]');
      const fields = [
        get<HTMLInputElement>('[data-inverter-efficiency]'),
        get<HTMLInputElement>('[data-inverter-standby]'),
        get<HTMLInputElement>('[data-inverter-standby-hours]'),
      ];
      outputVoltage.required = hasAcLoads;
      fields.forEach((field) => {
        field.required = hasAcLoads;
        field.disabled = !hasAcLoads;
      });
      referenceWrap.hidden = !hasAcLoads || outputVoltage.value !== '230';
      referenceWrap.querySelector('input')?.toggleAttribute('disabled', !hasAcLoads || outputVoltage.value !== '230');
      if ((!hasAcLoads || outputVoltage.value !== '230') && useReference.checked) {
        useReference.checked = false;
        get<HTMLInputElement>('[data-inverter-efficiency]').value = '';
        get<HTMLInputElement>('[data-inverter-standby]').value = '';
        get<HTMLInputElement>('[data-inverter-standby-hours]').value = '';
      }
      referenceNote.hidden = !hasAcLoads || !useReference.checked;
      get<HTMLElement>('[data-inverter-status]').textContent = outputVoltage.value === '230'
        ? 'Perfil de referência: eficiência máxima e consumo sem carga do modelo Victron correspondente a 12/24 V; ajuste as horas em espera.'
        : 'Para 127 V, 220 V ou 120 V, informe os valores da ficha do inversor escolhido; não há perfil de referência cadastrado.';
      updateSummary();
    }

    function applyInverterReference() {
      const inverter = inverterCatalog.find((item) => item.batteryVoltageV === systemVoltage() && item.outputVoltageV === 230);
      if (!inverter) throw new Error(`Perfil de inversor 230 V não encontrado para ${systemVoltage()} V.`);
      get<HTMLInputElement>('[data-inverter-efficiency]').value = String(inverter.maximumEfficiency * 100);
      get<HTMLInputElement>('[data-inverter-standby]').value = String(inverter.zeroLoadPowerW);
      get<HTMLInputElement>('[data-inverter-standby-hours]').value = '';
      updateInverterFields();
    }

    function readBatteryConfig(): {
      battery: BatteryParameters;
      chargeVoltageV: number;
      dischargeCutoffVoltageV: number;
      unitCapacityAh: number;
      unitVoltageV: number;
      maxParallelBatteries?: number;
    } | undefined {
      const chemistry = selectedChemistry();
      if (chemistry === 'lifepo4') {
        const profile = batteryCatalog.find((item) => item.id === get<HTMLSelectElement>('[data-battery-profile]').value);
        const nominalVoltageV = numeric('[data-lfp-nominal-voltage]');
        const unitCapacityAh = numeric('[data-lfp-capacity]');
        const depthOfDischarge = numeric('[data-lfp-dod]');
        const chargeEfficiency = numeric('[data-lfp-charge-efficiency]');
        const dischargeEfficiency = numeric('[data-lfp-discharge-efficiency]');
        const chargeVoltageV = numeric('[data-lfp-charge-voltage]');
        const dischargeCutoffVoltageV = numeric('[data-lfp-cutoff-voltage]');
        if (!profile || profile.systemVoltageV !== systemVoltage()
          || nominalVoltageV === undefined || unitCapacityAh === undefined
          || depthOfDischarge === undefined || chargeEfficiency === undefined
          || dischargeEfficiency === undefined || chargeVoltageV === undefined
          || dischargeCutoffVoltageV === undefined
          || Math.abs(nominalVoltageV - systemVoltage()) > systemVoltage() * 0.1
          || chargeVoltageV <= systemVoltage() || dischargeCutoffVoltageV >= systemVoltage()) return undefined;
        const optionalCurrent = (selector: string) => numeric(selector);
        return {
          battery: {
            chemistry,
            nominalVoltageV,
            depthOfDischarge: depthOfDischarge / 100,
            chargeEfficiency: chargeEfficiency / 100,
            dischargeEfficiency: dischargeEfficiency / 100,
            maxChargeCurrentA: optionalCurrent('[data-lfp-max-charge]'),
            maxContinuousDischargeCurrentA: optionalCurrent('[data-lfp-max-discharge]'),
            maxPeakDischargeCurrentA: optionalCurrent('[data-lfp-max-peak]'),
          },
          chargeVoltageV,
          dischargeCutoffVoltageV,
          unitCapacityAh,
          unitVoltageV: nominalVoltageV,
          maxParallelBatteries: profile.maxParallelBatteries,
        };
      }

      const unitCapacityAh = numeric('[data-lead-capacity]');
      const depthOfDischarge = numeric('[data-lead-dod]');
      const chargeEfficiency = numeric('[data-lead-charge-efficiency]');
      const dischargeEfficiency = numeric('[data-lead-discharge-efficiency]');
      const chargeVoltageV = numeric('[data-lead-charge-voltage]');
      const dischargeCutoffVoltageV = numeric('[data-lead-cutoff-voltage]');
      const unitVoltageV = Number(get<HTMLSelectElement>('[data-lead-unit-voltage]').value);
      if (unitCapacityAh === undefined || depthOfDischarge === undefined
        || chargeEfficiency === undefined || dischargeEfficiency === undefined
      || chargeVoltageV === undefined || dischargeCutoffVoltageV === undefined
      || chargeVoltageV <= systemVoltage() || dischargeCutoffVoltageV >= systemVoltage()) return undefined;
      return {
        battery: {
          chemistry,
          nominalVoltageV: systemVoltage(),
          depthOfDischarge: depthOfDischarge / 100,
          chargeEfficiency: chargeEfficiency / 100,
          dischargeEfficiency: dischargeEfficiency / 100,
          maxChargeCurrentA: numeric('[data-lead-max-charge]'),
          maxContinuousDischargeCurrentA: numeric('[data-lead-max-discharge]'),
        },
        chargeVoltageV,
        dischargeCutoffVoltageV,
        unitCapacityAh,
        unitVoltageV,
      };
    }

    function readInverterConfig() {
      const hasAcLoads = getCompatibleLoads().some((load) => load.supply === 'ac');
      if (!hasAcLoads) return { efficiency: 1, standbyPowerW: 0, standbyHoursPerDay: 0 };
      const outputVoltage = get<HTMLSelectElement>('[data-ac-output]').value;
      const efficiencyPercent = numeric('[data-inverter-efficiency]');
      const standbyPowerW = numeric('[data-inverter-standby]');
      const standbyHoursPerDay = numeric('[data-inverter-standby-hours]');
      if (!outputVoltage || efficiencyPercent === undefined || standbyPowerW === undefined || standbyHoursPerDay === undefined) return undefined;
      return { efficiency: efficiencyPercent / 100, standbyPowerW, standbyHoursPerDay };
    }

    function setReportDefinitionList(selector: string, entries: Array<[string, string]>) {
      const list = get<HTMLDListElement>(selector);
      list.replaceChildren();
      entries.forEach(([label, value]) => {
        const row = document.createElement('div');
        const term = document.createElement('dt');
        const description = document.createElement('dd');
        term.textContent = label;
        description.textContent = value;
        row.append(term, description);
        list.append(row);
      });
    }

    function setReportTable(selector: string, rows: string[][]) {
      const body = get<HTMLTableSectionElement>(selector);
      body.replaceChildren();
      rows.forEach((values) => {
        const row = document.createElement('tr');
        values.forEach((value) => {
          const cell = document.createElement('td');
          cell.textContent = value;
          row.append(cell);
        });
        body.append(row);
      });
    }

    function setReportList(selector: string, entries: string[]) {
      const list = get<HTMLUListElement>(selector);
      list.replaceChildren();
      entries.forEach((entry) => {
        const item = document.createElement('li');
        item.textContent = entry;
        list.append(item);
      });
    }

    function renderReport() {
      const status = get<HTMLElement>('[data-project-file-status]');
      const loads = getCompatibleLoads();
      const inverter = readInverterConfig();
      const batteryConfig = readBatteryConfig();
      const autonomyDays = numeric('[data-autonomy]');
      const peakSunHours = numeric('[data-hsp]');
      if (!loads.length || !inverter || !batteryConfig || autonomyDays === undefined || peakSunHours === undefined) {
        status.textContent = 'Não foi possível gerar o relatório. Revise as cargas, a HSP, a autonomia e os dados da bateria/inversor.';
        return;
      }

      try {
        const vehicle = get<HTMLSelectElement>('[data-vehicle-type]');
        const vehicleLabelPt = vehicle.selectedOptions[0]?.textContent?.trim() || 'Não informado';
        const countryIso3 = get<HTMLSelectElement>('[data-country]').value;
        const country = solarResourceCountries.find((item) => item.countryIso3 === countryIso3);
        const countryLabelPt = country?.countryNamePt ?? 'Informada pelo usuário';
        const categoryLabel = (categoryId: string) =>
          equipmentCategories.find((category) => category.id === categoryId)?.labelPt ?? 'Outros';
        const reportLoads = loads.map((load) => {
          const catalogItem = equipmentCatalog.find((item) => item.id === load.id);
          if (catalogItem) {
            return {
              name: catalogItem.namePt,
              categoryLabelPt: categoryLabel(catalogItem.categoryId),
              originLabelPt: load.quantity === 1
                ? 'Referência do catálogo (editável)'
                : 'Referência do catálogo; quantidade ajustada',
              load,
            };
          }
          const customItem = customLoads.find((item) => item.load.id === load.id);
          if (!customItem) throw new Error(`Carga selecionada sem identificação para o relatório: ${load.id}.`);
          return {
            name: customItem.name,
            categoryLabelPt: categoryLabel(customItem.categoryId),
            originLabelPt: 'Dados informados pelo usuário',
            load,
          };
        });
        const batteryProfile = batteryCatalog.find((item) => item.id === get<HTMLSelectElement>('[data-battery-profile]').value);
        const batteryProfileLabelPt = selectedChemistry() === 'lifepo4'
          ? batteryProfile?.namePt ?? 'Referência LiFePO₄'
          : 'Bateria chumbo-ácido informada pelo usuário';
        const generatedAt = new Date();
        const report = buildSolarReport({
          projectName: get<HTMLInputElement>('[data-project-name]').value.trim(),
          generatedAt: generatedAt.toLocaleString('pt-BR'),
          applicationVersion: solarApplicationVersion,
          vehicleLabelPt,
          systemVoltageV: systemVoltage(),
          countryLabelPt,
          peakSunHours,
          loads: reportLoads,
          inverter: {
            ...inverter,
            outputVoltageV: get<HTMLSelectElement>('[data-ac-output]').value
              ? Number(get<HTMLSelectElement>('[data-ac-output]').value)
              : null,
          },
          battery: {
            ...batteryConfig.battery,
            chargeVoltageV: batteryConfig.chargeVoltageV,
            dischargeCutoffVoltageV: batteryConfig.dischargeCutoffVoltageV,
          },
          autonomyDays,
          unitCapacityAh: batteryConfig.unitCapacityAh,
          unitVoltageV: batteryConfig.unitVoltageV,
          maxParallelBatteries: batteryConfig.maxParallelBatteries,
          batteryProfileLabelPt,
        });
        const batteryCount = report.batteryConfiguration.withinKnownLimit
          ? `${report.batteryConfiguration.totalCount} ${report.batteryConfiguration.totalCount === 1 ? 'unidade' : 'unidades'} (${report.batteryConfiguration.seriesCount} em série × ${report.batteryConfiguration.parallelCount} em paralelo)`
          : `Não recomendada: excede ${report.batteryConfiguration.maxParallelBatteries} unidades em paralelo`;
        const inverterSummary = report.inverter
          ? `${format(report.inverter.minimumContinuousPowerW)} W contínuos e ${format(report.inverter.minimumPeakPowerW)} W de pico; corrente mínima no banco de ${format(report.inverter.minimumContinuousBatteryCurrentA)} A contínuos e ${format(report.inverter.minimumPeakBatteryCurrentA)} A de pico. Eficiência usada: ${format(report.inverterEfficiency * 100)}%; consumo em espera: ${format(report.inverterStandbyPowerW)} W por ${format(report.inverterStandbyHoursPerDay)} h/dia. Verificação: ${report.inverter.compatibility === 'within-known-limits' ? 'dentro dos limites informados' : report.inverter.compatibility === 'exceeds-known-limits' ? 'excede limite informado' : 'requer confirmação de limites da bateria/BMS'}.`
          : 'Não necessário no cenário atual: nenhuma carga AC foi selecionada.';
        const outputVoltage = report.inverterOutputVoltageV
          ? `${report.inverterOutputVoltageV} V`
          : 'Não configurada (sem cargas AC)';
        const inverterDetails = report.inverter
          ? `${inverterSummary} Saída configurada: ${outputVoltage}. Recomenda-se onda senoidal pura; confira potência de partida e compatibilidade da bateria/BMS.`
          : inverterSummary;

        get<HTMLElement>('[data-report-title]').textContent = report.projectName || 'Pré-dimensionamento do sistema';
        get<HTMLElement>('[data-report-project-name]').textContent = report.projectName || 'Sem nome';
        get<HTMLElement>('[data-report-vehicle]').textContent = report.vehicleLabelPt;
        get<HTMLElement>('[data-report-system]').textContent = `${report.systemVoltageV} V`;
        get<HTMLElement>('[data-report-sun]').textContent =
          `${report.countryLabelPt} · ${format(report.peakSunHours, 3)} h/dia`;
        get<HTMLElement>('[data-report-generated]').textContent = report.generatedAt;
        get<HTMLElement>('[data-report-version]').textContent = report.applicationVersion;

        setReportDefinitionList('[data-report-summary]', [
          ['Consumo no barramento da bateria', `${format(report.consumption.totalAtBatteryBusWhPerDay)} Wh/dia · ${format(report.consumption.totalAtBatteryBusWhPerDay / 1000, 3)} kWh/dia`],
          ['Autonomia desejada', `${format(report.battery.autonomyDays)} ${report.battery.autonomyDays === 1 ? 'dia' : 'dias'}`],
          ['Banco de baterias', `${report.battery.chemistry === 'lifepo4' ? 'LiFePO₄' : 'Chumbo-ácido'} · ${format(report.battery.nominalCapacityAh)} Ah nominais · ${batteryCount}`],
          ['Potência fotovoltaica', report.pvStatus],
          ['Controlador', report.mpptStatus],
          ['Inversor', inverterSummary],
          ['Carregador DC-DC', report.dcDcChargerStatus],
          ['Carregador AC-DC', report.acDcChargerStatus],
        ]);
        setReportTable('[data-report-loads]', report.loads.map((load) => [
          load.name,
          load.categoryLabelPt,
          String(load.quantity),
          `${load.supply.toUpperCase()} · ${load.basisSummaryPt}`,
          `${format(load.energyWhPerDay)} Wh/dia`,
          load.originLabelPt,
        ]));
        const excludedCatalogLoads = equipmentCatalog.flatMap((item) => {
          const card = root.querySelector<HTMLElement>(`[data-equipment-id="${item.id}"]`);
          const choice = card?.querySelector<HTMLInputElement>('[data-catalog-choice]');
          return choice?.checked && !item.applicableSystemVoltagesV.includes(systemVoltage())
            ? [item.namePt]
            : [];
        });
        get<HTMLElement>('[data-report-excluded-loads]').textContent = excludedCatalogLoads.length
          ? `Referências selecionadas, mas excluídas por incompatibilidade de tensão: ${excludedCatalogLoads.join('; ')}.`
          : '';
        const formatCurrentLimit = (value: number | undefined) =>
          value === undefined ? 'não informado' : `${format(value)} A`;
        setReportDefinitionList('[data-report-battery]', [
          ['Perfil', report.batteryConfiguration.profileLabelPt],
          ['Capacidade nominal calculada', `${format(report.battery.nominalCapacityWh)} Wh · ${format(report.battery.nominalCapacityAh)} Ah`],
          ['Capacidade utilizável calculada', `${format(report.battery.usableCapacityWh)} Wh`],
          ['Configuração por capacidade', batteryCount],
          ['Profundidade de descarga usada', `${format(report.battery.depthOfDischarge * 100)}%`],
          ['Eficiência de descarga', `${format(report.battery.dischargeEfficiency * 100)}%`],
          ['Eficiência de carga', `${format(report.batteryConfiguration.chargeEfficiency * 100)}%`],
          ['Tensão nominal da bateria', `${format(report.battery.batteryNominalVoltageV)} V`],
          ['Tensão de carga / corte', `${format(report.batteryConfiguration.chargeVoltageV)} V / ${format(report.batteryConfiguration.dischargeCutoffVoltageV)} V`],
          ['Limites de corrente', `Carga: ${formatCurrentLimit(batteryConfig.battery.maxChargeCurrentA)}; descarga contínua: ${formatCurrentLimit(batteryConfig.battery.maxContinuousDischargeCurrentA)}; pico: ${formatCurrentLimit(batteryConfig.battery.maxPeakDischargeCurrentA)}.`],
          ['Memória simplificada', `${format(report.battery.dailyEnergyAtBatteryBusWh)} Wh/dia × ${format(report.battery.autonomyDays)} dias ÷ (DoD × eficiência de descarga).`],
        ]);
        const resourceSource = country
          ? `${solarResourceDataset.sourceName}, média nacional do período ${solarResourceDataset.referencePeriodStartYear}–${solarResourceDataset.referencePeriodEndYear}.`
          : 'Valor informado pelo usuário; a fonte não foi registrada nesta configuração.';
        setReportDefinitionList('[data-report-pv]', [
          ['HSP adotada', `${format(report.peakSunHours, 3)} h/dia · ${resourceSource}`],
          ['Potência e arranjo', report.pvStatus],
          ['Fator de desempenho', 'Não definido: não foi adotado um valor genérico sem fonte aprovada.'],
          ['Limitação regional', 'A HSP nacional ou manual não representa uma medição local nem uma condição sazonal.'],
        ]);
        setReportDefinitionList('[data-report-components]', [
          ['Controlador MPPT', report.mpptStatus],
          ['Inversor DC-AC', inverterDetails],
          ['Carregador DC-DC (alternador)', report.dcDcChargerStatus],
          ['Carregador AC-DC (rede externa)', report.acDcChargerStatus],
        ]);
        setReportTable('[data-report-circuits]', report.cableCircuits.map((circuit) => [
          circuit.namePt,
          circuit.statusPt,
        ]));
        setReportList('[data-report-calculation-notes]', [
          `HSP utilizada: ${format(report.peakSunHours, 3)} h/dia (${resourceSource})`,
          ...report.calculationNotes,
        ]);
        const warnings = [...report.warnings];
        if (get<HTMLInputElement>('[data-use-victron-reference]').checked) {
          warnings.push('A eficiência do perfil Victron SUN selecionado é máxima; não é garantida em toda condição de carga.');
        }
        setReportList('[data-report-warnings]', warnings);
        status.textContent = 'Relatório atualizado. Os resultados são locais e os itens pendentes estão identificados.';
      } catch (calculationError) {
        if (!(calculationError instanceof TypeError || calculationError instanceof RangeError)) throw calculationError;
        status.textContent = `Não foi possível gerar o relatório: ${calculationError.message}`;
      }
    }

    function readBatteryFields(selectors: {
      nominalVoltageV: string;
      capacityAh: string;
      depthOfDischargePercent: string;
      chargeEfficiencyPercent: string;
      dischargeEfficiencyPercent: string;
      chargeVoltageV: string;
      cutoffVoltageV: string;
      maxChargeCurrentA: string;
      maxContinuousDischargeCurrentA: string;
      maxPeakDischargeCurrentA?: string;
    }): SolarProjectBatteryFields {
      const readNullable = (selector: string) => numeric(selector) ?? null;
      return {
        nominalVoltageV: readNullable(selectors.nominalVoltageV),
        capacityAh: readNullable(selectors.capacityAh),
        depthOfDischargePercent: readNullable(selectors.depthOfDischargePercent),
        chargeEfficiencyPercent: readNullable(selectors.chargeEfficiencyPercent),
        dischargeEfficiencyPercent: readNullable(selectors.dischargeEfficiencyPercent),
        chargeVoltageV: readNullable(selectors.chargeVoltageV),
        cutoffVoltageV: readNullable(selectors.cutoffVoltageV),
        maxChargeCurrentA: readNullable(selectors.maxChargeCurrentA),
        maxContinuousDischargeCurrentA: readNullable(selectors.maxContinuousDischargeCurrentA),
        maxPeakDischargeCurrentA: selectors.maxPeakDischargeCurrentA
          ? readNullable(selectors.maxPeakDischargeCurrentA)
          : null,
      };
    }

    function readProjectConfiguration(): SolarProjectConfiguration {
      const country = get<HTMLSelectElement>('[data-country]').value;
      const peakSunHours = numeric('[data-hsp]');
      if (peakSunHours === undefined) throw new RangeError('Informe a HSP antes de salvar o projeto.');
      const outputVoltageValue = get<HTMLSelectElement>('[data-ac-output]').value;
      const outputVoltageV: SolarProjectConfiguration['inverter']['outputVoltageV'] =
        outputVoltageValue === '120' ? 120
          : outputVoltageValue === '127' ? 127
            : outputVoltageValue === '220' ? 220
              : outputVoltageValue === '230' ? 230
                : null;
      const leadUnitVoltage = Number(get<HTMLSelectElement>('[data-lead-unit-voltage]').value);
      if (leadUnitVoltage !== 12 && leadUnitVoltage !== 24) {
        throw new RangeError('A tensão por bateria não corresponde a uma opção disponível.');
      }
      const readNullable = (selector: string) => numeric(selector) ?? null;
      const catalogLoads = equipmentCatalog.map((item) => {
        const card = root.querySelector<HTMLElement>(`[data-equipment-id="${item.id}"]`);
        const choice = card?.querySelector<HTMLInputElement>('[data-catalog-choice]');
        const quantity = card?.querySelector<HTMLInputElement>('[data-catalog-quantity]');
        if (!choice || !quantity) throw new Error(`Campos do catálogo não encontrados: ${item.id}.`);
        return { equipmentId: item.id, selected: choice.checked, quantity: Number(quantity.value) || 1 };
      });
      return {
        projectName: get<HTMLInputElement>('[data-project-name]').value,
        vehicleType: get<HTMLSelectElement>('[data-vehicle-type]').value,
        systemVoltageV: systemVoltage(),
        countryIso3: country,
        peakSunHours,
        catalogLoads,
        customLoads: customLoads.map((item) => ({
          name: item.name,
          categoryId: item.categoryId,
          load: structuredClone(item.load),
        })),
        autonomyDays: numeric('[data-autonomy]') ?? null,
        battery: {
          chemistry: selectedChemistry(),
          profileId: get<HTMLSelectElement>('[data-battery-profile]').value,
          lifepo4: readBatteryFields({
            nominalVoltageV: '[data-lfp-nominal-voltage]',
            capacityAh: '[data-lfp-capacity]',
            depthOfDischargePercent: '[data-lfp-dod]',
            chargeEfficiencyPercent: '[data-lfp-charge-efficiency]',
            dischargeEfficiencyPercent: '[data-lfp-discharge-efficiency]',
            chargeVoltageV: '[data-lfp-charge-voltage]',
            cutoffVoltageV: '[data-lfp-cutoff-voltage]',
            maxChargeCurrentA: '[data-lfp-max-charge]',
            maxContinuousDischargeCurrentA: '[data-lfp-max-discharge]',
            maxPeakDischargeCurrentA: '[data-lfp-max-peak]',
          }),
          leadAcid: readBatteryFields({
            nominalVoltageV: '[data-lead-unit-voltage]',
            capacityAh: '[data-lead-capacity]',
            depthOfDischargePercent: '[data-lead-dod]',
            chargeEfficiencyPercent: '[data-lead-charge-efficiency]',
            dischargeEfficiencyPercent: '[data-lead-discharge-efficiency]',
            chargeVoltageV: '[data-lead-charge-voltage]',
            cutoffVoltageV: '[data-lead-cutoff-voltage]',
            maxChargeCurrentA: '[data-lead-max-charge]',
            maxContinuousDischargeCurrentA: '[data-lead-max-discharge]',
          }),
          leadUnitVoltageV: leadUnitVoltage,
        },
        inverter: {
          outputVoltageV,
          useVictronReference: get<HTMLInputElement>('[data-use-victron-reference]').checked,
          efficiencyPercent: readNullable('[data-inverter-efficiency]'),
          standbyPowerW: readNullable('[data-inverter-standby]'),
          standbyHoursPerDay: readNullable('[data-inverter-standby-hours]'),
        },
      };
    }

    function exportProjectFile() {
      const status = get<HTMLElement>('[data-project-file-status]');
      const file: SolarProjectFile = {
        format: 'odisseia-solar-project',
        version: 1,
        savedAt: new Date().toISOString(),
        config: readProjectConfiguration(),
      };
      validateSolarProjectFile(file);
      const blob = new Blob([JSON.stringify(file, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      const safeName = file.config.projectName
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '') || 'odisseia-solar';
      link.href = url;
      link.download = `${safeName}.odisseia-solar.json`;
      document.body.append(link);
      link.click();
      link.remove();
      window.setTimeout(() => URL.revokeObjectURL(url), 1000);
      status.textContent = 'Arquivo JSON preparado para download local. Nenhum dado foi enviado.';
    }

    function setBatteryFields(fields: SolarProjectBatteryFields, selectors: {
      nominalVoltageV: string;
      capacityAh: string;
      depthOfDischargePercent: string;
      chargeEfficiencyPercent: string;
      dischargeEfficiencyPercent: string;
      chargeVoltageV: string;
      cutoffVoltageV: string;
      maxChargeCurrentA: string;
      maxContinuousDischargeCurrentA: string;
      maxPeakDischargeCurrentA?: string;
    }) {
      const values = [
        ['nominalVoltageV', selectors.nominalVoltageV],
        ['capacityAh', selectors.capacityAh],
        ['depthOfDischargePercent', selectors.depthOfDischargePercent],
        ['chargeEfficiencyPercent', selectors.chargeEfficiencyPercent],
        ['dischargeEfficiencyPercent', selectors.dischargeEfficiencyPercent],
        ['chargeVoltageV', selectors.chargeVoltageV],
        ['cutoffVoltageV', selectors.cutoffVoltageV],
        ['maxChargeCurrentA', selectors.maxChargeCurrentA],
        ['maxContinuousDischargeCurrentA', selectors.maxContinuousDischargeCurrentA],
        ...(selectors.maxPeakDischargeCurrentA
          ? [['maxPeakDischargeCurrentA', selectors.maxPeakDischargeCurrentA] as const]
          : []),
      ] as const;
      values.forEach(([key, selector]) => {
        const field = root.querySelector<HTMLInputElement | HTMLSelectElement>(selector);
        if (field) field.value = fields[key] === null ? '' : String(fields[key]);
      });
    }

    function applyProjectConfiguration(config: SolarProjectConfiguration) {
      get<HTMLInputElement>('[data-project-name]').value = config.projectName;
      get<HTMLSelectElement>('[data-vehicle-type]').value = config.vehicleType;
      const systemVoltageRadio = root.querySelector<HTMLInputElement>(
        `input[name="systemVoltageV"][value="${config.systemVoltageV}"]`,
      );
      if (!systemVoltageRadio) throw new Error('Campo de tensão do banco não encontrado.');
      systemVoltageRadio.checked = true;
      get<HTMLSelectElement>('[data-country]').value = config.countryIso3;
      get<HTMLInputElement>('[data-hsp]').value = String(config.peakSunHours);
      equipmentCatalog.forEach((item) => {
        const card = root.querySelector<HTMLElement>(`[data-equipment-id="${item.id}"]`);
        const choice = card?.querySelector<HTMLInputElement>('[data-catalog-choice]');
        const quantity = card?.querySelector<HTMLInputElement>('[data-catalog-quantity]');
        const saved = config.catalogLoads.find((load) => load.equipmentId === item.id);
        if (choice && quantity) {
          choice.checked = saved?.selected ?? false;
          quantity.value = String(saved?.quantity ?? 1);
        }
      });
      customLoads.splice(0, customLoads.length, ...config.customLoads.map((item) => ({
        name: item.name,
        categoryId: item.categoryId,
        load: structuredClone(item.load),
      })));
      customLoadNumber = customLoads.reduce((largest, item) => {
        const match = /^custom-load-(\d+)$/.exec(item.load.id);
        return Math.max(largest, match ? Number(match[1]) : 0);
      }, 0);
      get<HTMLSelectElement>('[data-custom-basis]').value = 'power-time';
      get<HTMLSelectElement>('[data-custom-supply]').value = 'dc';
      get<HTMLInputElement>('[data-autonomy]').value = config.autonomyDays === null ? '' : String(config.autonomyDays);
      root.querySelectorAll<HTMLInputElement>('[data-battery-chemistry]').forEach((radio) => {
        radio.checked = radio.value === config.battery.chemistry;
      });
      get<HTMLSelectElement>('[data-battery-profile]').value = config.battery.profileId;
      setBatteryFields(config.battery.lifepo4, {
        nominalVoltageV: '[data-lfp-nominal-voltage]',
        capacityAh: '[data-lfp-capacity]',
        depthOfDischargePercent: '[data-lfp-dod]',
        chargeEfficiencyPercent: '[data-lfp-charge-efficiency]',
        dischargeEfficiencyPercent: '[data-lfp-discharge-efficiency]',
        chargeVoltageV: '[data-lfp-charge-voltage]',
        cutoffVoltageV: '[data-lfp-cutoff-voltage]',
        maxChargeCurrentA: '[data-lfp-max-charge]',
        maxContinuousDischargeCurrentA: '[data-lfp-max-discharge]',
        maxPeakDischargeCurrentA: '[data-lfp-max-peak]',
      });
      setBatteryFields(config.battery.leadAcid, {
        nominalVoltageV: '[data-lead-unit-voltage]',
        capacityAh: '[data-lead-capacity]',
        depthOfDischargePercent: '[data-lead-dod]',
        chargeEfficiencyPercent: '[data-lead-charge-efficiency]',
        dischargeEfficiencyPercent: '[data-lead-discharge-efficiency]',
        chargeVoltageV: '[data-lead-charge-voltage]',
        cutoffVoltageV: '[data-lead-cutoff-voltage]',
        maxChargeCurrentA: '[data-lead-max-charge]',
        maxContinuousDischargeCurrentA: '[data-lead-max-discharge]',
      });
      get<HTMLSelectElement>('[data-lead-unit-voltage]').value = String(config.battery.leadUnitVoltageV);
      get<HTMLSelectElement>('[data-ac-output]').value = config.inverter.outputVoltageV === null
        ? ''
        : String(config.inverter.outputVoltageV);
      get<HTMLInputElement>('[data-use-victron-reference]').checked = config.inverter.useVictronReference;
      get<HTMLInputElement>('[data-inverter-efficiency]').value =
        config.inverter.efficiencyPercent === null ? '' : String(config.inverter.efficiencyPercent);
      get<HTMLInputElement>('[data-inverter-standby]').value =
        config.inverter.standbyPowerW === null ? '' : String(config.inverter.standbyPowerW);
      get<HTMLInputElement>('[data-inverter-standby-hours]').value =
        config.inverter.standbyHoursPerDay === null ? '' : String(config.inverter.standbyHoursPerDay);
      updateCustomBasis();
      updateCatalogChoices();
      updateBatteryChoice();
      updateInverterFields();
      renderSelectedLoads();
      updateSummary();
      renderReport();
    }

    async function importProjectFile(file: File) {
      const status = get<HTMLElement>('[data-project-file-status]');
      if (file.size > 1_000_000) {
        status.textContent = 'O arquivo excede o limite de 1 MB e não foi importado.';
        return;
      }
      let text: string;
      try {
        text = await file.text();
      } catch (error) {
        if (error instanceof DOMException) {
          status.textContent = 'Não foi possível ler o arquivo selecionado.';
          return;
        }
        throw error;
      }
      let parsed: unknown;
      try {
        parsed = JSON.parse(text);
      } catch (error) {
        if (error instanceof SyntaxError) {
          status.textContent = 'O arquivo não contém JSON válido.';
          return;
        }
        throw error;
      }
      let project: SolarProjectFile;
      try {
        project = validateSolarProjectFile(parsed);
        const candidateLoads = [
          ...equipmentCatalog.flatMap((item) => {
            const choice = project.config.catalogLoads.find((saved) => saved.equipmentId === item.id);
            return choice?.selected && item.applicableSystemVoltagesV.includes(project.config.systemVoltageV)
              ? [{ ...item.defaultLoad, quantity: choice.quantity }]
              : [];
          }),
          ...project.config.customLoads.map((item) => item.load),
        ];
        if (candidateLoads.length) {
          calculateDailyConsumption(
            candidateLoads,
            project.config.systemVoltageV,
            (project.config.inverter.efficiencyPercent ?? 100) / 100,
            project.config.inverter.standbyPowerW ?? 0,
            project.config.inverter.standbyHoursPerDay ?? 0,
          );
        }
      } catch (error) {
        if (error instanceof TypeError || error instanceof RangeError) {
          status.textContent = `Arquivo recusado: ${error.message}`;
          return;
        }
        throw error;
      }
      applyProjectConfiguration(project.config);
      status.textContent = 'Projeto importado neste dispositivo. Revise os dados antes de usar os resultados.';
    }

    function updateSummary() {
      const vehicle = get<HTMLSelectElement>('[data-vehicle-type]');
      get<HTMLElement>('[data-summary-vehicle]').textContent = vehicle.selectedOptions[0]?.textContent?.trim() || 'Aguardando seleção';
      get<HTMLElement>('[data-summary-voltage]').textContent = `${systemVoltage()} V`;
      const countryValue = get<HTMLSelectElement>('[data-country]').value;
      const country = solarResourceCountries.find((item) => item.countryIso3 === countryValue);
      const hsp = numeric('[data-hsp]');
      get<HTMLElement>('[data-summary-sun]').textContent = country && hsp !== undefined
        ? `${country.countryNamePt} · ${format(hsp, 3)} h/dia`
        : hsp !== undefined ? `Informada · ${format(hsp, 3)} h/dia` : 'Informe a HSP';

      const loads = getCompatibleLoads();
      const energyNode = get<HTMLElement>('[data-summary-energy]');
      const capacityNode = get<HTMLElement>('[data-summary-capacity]');
      const countNode = get<HTMLElement>('[data-summary-battery-count]');
      const summaryStatus = get<HTMLElement>('[data-summary-status]');
      const summaryNote = get<HTMLElement>('[data-summary-note]');
      summaryNote.textContent = '';
      if (!loads.length) {
        energyNode.textContent = 'Selecione as cargas';
        capacityNode.textContent = 'Aguardando consumo';
        countNode.textContent = '—';
        summaryStatus.textContent = 'Adicione uma carga compatível com a tensão selecionada.';
        return;
      }

      let applianceEnergy = 0;
      try {
        applianceEnergy = loads.reduce((sum, load) =>
          sum + calculateDailyConsumption([load], systemVoltage(), 1, 0, 0).loads[0].applianceEnergyWhPerDay, 0);
      } catch (calculationError) {
        if (!(calculationError instanceof TypeError || calculationError instanceof RangeError)) throw calculationError;
        energyNode.textContent = 'Verifique quantidade e tensão';
        capacityNode.textContent = 'Corrija os dados das cargas';
        countNode.textContent = '—';
        summaryStatus.textContent = calculationError.message;
        return;
      }
      const inverter = readInverterConfig();
      if (!inverter) {
        energyNode.textContent = 'Pendente: dados do inversor';
        capacityNode.textContent = 'Pendente: perdas AC';
        countNode.textContent = '—';
        summaryStatus.textContent = `As cargas representam ${format(applianceEnergy)} Wh/dia antes das perdas do inversor.`;
        summaryNote.textContent = 'Informe eficiência, consumo sem carga e horas em espera do inversor para incluir as cargas AC no banco.';
        return;
      }

      try {
        const consumption = calculateDailyConsumption(
          loads,
          systemVoltage(),
          inverter.efficiency,
          inverter.standbyPowerW,
          inverter.standbyHoursPerDay,
        );
        energyNode.textContent = `${format(consumption.totalAtBatteryBusWhPerDay)} Wh/dia`;
        const autonomyDays = numeric('[data-autonomy]');
        const batteryConfig = readBatteryConfig();
        if (autonomyDays === undefined || !batteryConfig) {
          capacityNode.textContent = autonomyDays === undefined ? 'Informe a autonomia' : 'Complete os dados da bateria';
          countNode.textContent = '—';
          summaryStatus.textContent = 'Consumo calculado; capacidade depende da autonomia e dos parâmetros completos da bateria.';
          return;
        }
        const sizing = calculateBatteryCapacity(
          consumption.totalAtBatteryBusWhPerDay,
          autonomyDays,
          systemVoltage(),
          batteryConfig.battery,
        );
        capacityNode.textContent = `${format(sizing.nominalCapacityWh)} Wh · ${format(sizing.nominalCapacityAh)} Ah`;
        const seriesCount = selectedChemistry() === 'lifepo4'
          ? 1
          : systemVoltage() / batteryConfig.unitVoltageV;
        if (!Number.isInteger(seriesCount) || seriesCount < 1) {
          countNode.textContent = 'Verifique a tensão por bateria';
          summaryStatus.textContent = 'A tensão da unidade não forma um banco compatível com o sistema selecionado.';
          return;
        }
        const parallelCount = Math.ceil(sizing.nominalCapacityAh / batteryConfig.unitCapacityAh);
        const totalCount = parallelCount * seriesCount;
        if (batteryConfig.maxParallelBatteries !== undefined && parallelCount > batteryConfig.maxParallelBatteries) {
          countNode.textContent = `Excede ${batteryConfig.maxParallelBatteries} em paralelo`;
          summaryStatus.textContent = 'A capacidade calculada supera a configuração em paralelo publicada para esse perfil. Não há recomendação de quantidade.';
          return;
        }
        countNode.textContent = `${totalCount} ${totalCount === 1 ? 'bateria' : 'baterias'} (${seriesCount} em série × ${parallelCount} em paralelo)`;
        summaryStatus.textContent = `Estimativa para ${format(autonomyDays)} ${autonomyDays === 1 ? 'dia' : 'dias'} de autonomia; confira os limites do modelo e do BMS.`;
        summaryNote.textContent = selectedChemistry() === 'lead-acid'
          ? 'Quantidade calculada pela capacidade informada. Confirme no manual as ligações em série/paralelo e os limites de corrente.'
          : 'Quantidade calculada pelo perfil de capacidade informado; revise o perfil, as eficiências e a condição de uso antes de escolher a bateria.';
      } catch (calculationError) {
        if (!(calculationError instanceof TypeError || calculationError instanceof RangeError)) throw calculationError;
        energyNode.textContent = 'Não foi possível calcular';
        capacityNode.textContent = 'Verifique os valores informados';
        countNode.textContent = '—';
        summaryStatus.textContent = calculationError.message;
      }
    }

    get<HTMLSelectElement>('[data-country]').addEventListener('change', updateHsp);
    get<HTMLInputElement>('[data-hsp]').addEventListener('input', () => {
      const status = get<HTMLElement>('[data-hsp-status]');
      if (get<HTMLSelectElement>('[data-country]').value !== 'manual') {
        status.textContent = 'Valor editado pelo usuário; a média nacional do catálogo pode não representar a região ou estação.';
      }
      updateSummary();
    });
    get<HTMLSelectElement>('[data-custom-basis]').addEventListener('change', updateCustomBasis);
    get<HTMLSelectElement>('[data-custom-supply]').addEventListener('change', updateCustomBasis);
    get<HTMLButtonElement>('[data-add-custom-load]').addEventListener('click', addCustomLoad);
    get<HTMLSelectElement>('[data-battery-profile]').addEventListener('change', (event) => {
      applyLifepo4Profile((event.currentTarget as HTMLSelectElement).value);
      updateSummary();
    });
    get<HTMLInputElement>('[data-use-victron-reference]').addEventListener('change', (event) => {
      const checked = (event.currentTarget as HTMLInputElement).checked;
      if (checked) applyInverterReference();
      else {
        get<HTMLInputElement>('[data-inverter-efficiency]').value = '';
        get<HTMLInputElement>('[data-inverter-standby]').value = '';
        get<HTMLInputElement>('[data-inverter-standby-hours]').value = '';
        updateInverterFields();
      }
    });
    get<HTMLSelectElement>('[data-ac-output]').addEventListener('change', updateInverterFields);
    root.querySelectorAll<HTMLInputElement>('input[name="batteryChemistry"]').forEach((radio) =>
      radio.addEventListener('change', updateBatteryChoice));
    root.querySelectorAll<HTMLInputElement>('input[name="systemVoltageV"]').forEach((radio) => {
      radio.addEventListener('change', () => {
        updateCatalogChoices();
        if (selectedChemistry() === 'lifepo4') applyLifepo4Profile(profileForCurrentVoltage().id);
        updateBatteryChoice();
        if (get<HTMLInputElement>('[data-use-victron-reference]').checked) applyInverterReference();
        updateInverterFields();
        updateSummary();
      });
    });
    root.querySelectorAll<HTMLInputElement>('[data-catalog-choice]').forEach((choice) => {
      choice.addEventListener('change', () => {
        const card = choice.closest<HTMLElement>('[data-catalog-equipment]');
        const quantity = card?.querySelector<HTMLInputElement>('[data-catalog-quantity]');
        if (quantity) quantity.disabled = !choice.checked || choice.disabled;
        renderSelectedLoads();
        updateInverterFields();
        updateSummary();
      });
    });
    root.querySelectorAll<HTMLInputElement>('[data-catalog-quantity]').forEach((quantity) =>
      quantity.addEventListener('input', updateSummary));
    root.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea').forEach((field) => {
      field.addEventListener('input', updateSummary);
      field.addEventListener('change', updateSummary);
    });

    get<HTMLButtonElement>('[data-step-back]').addEventListener('click', () => {
      if (activeStep > 0) setPanel(activeStep - 1);
    });
    get<HTMLButtonElement>('[data-step-next]').addEventListener('click', () => {
      if (activeStep >= panels.length - 1) return;
      if (!validatePanel()) return;
      setPanel(activeStep + 1);
    });
    get<HTMLButtonElement>('[data-print-report]').addEventListener('click', () => {
      document.body.classList.add('solar-printing');
      window.print();
    });
    window.addEventListener('afterprint', () => document.body.classList.remove('solar-printing'));
    get<HTMLButtonElement>('[data-export-project]').addEventListener('click', () => {
      try {
        exportProjectFile();
      } catch (error) {
        if (error instanceof TypeError || error instanceof RangeError) {
          get<HTMLElement>('[data-project-file-status]').textContent = `Não foi possível salvar o projeto: ${error.message}`;
          return;
        }
        throw error;
      }
    });
    get<HTMLButtonElement>('[data-import-trigger]').addEventListener('click', () => {
      get<HTMLInputElement>('[data-import-project]').click();
    });
    get<HTMLInputElement>('[data-import-project]').addEventListener('change', async (event) => {
      const input = event.currentTarget as HTMLInputElement;
      const file = input.files?.[0];
      if (!file) return;
      await importProjectFile(file);
      input.value = '';
    });

    updateCustomBasis();
    updateCatalogChoices();
    updateBatteryChoice();
    updateInverterFields();
    renderSelectedLoads();
    updateSummary();
  }
</script>

