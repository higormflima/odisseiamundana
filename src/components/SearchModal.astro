---
interface Props {
  base: string;
}

const { base } = Astro.props;
---

<button class="search-trigger" type="button" aria-label="Abrir busca" aria-haspopup="dialog" aria-controls="site-search-dialog" aria-expanded="false" data-search-open>
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
    <circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 5 5"></path>
  </svg>
</button>

<dialog id="site-search-dialog" class="search-dialog" aria-label="Busca no site" data-search-dialog data-base={base}>
  <div class="search-panel">
    <form class="search-form" role="search" data-search-form>
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 5 5"></path>
      </svg>
      <label class="visually-hidden" for="site-search-input">Buscar no site</label>
      <input id="site-search-input" type="search" role="combobox" aria-autocomplete="list" aria-controls="site-search-results" aria-expanded="false" placeholder="Buscar viagens, destinos e histórias…" autocomplete="off" data-search-input />
      <button class="search-clear" type="button" aria-label="Limpar busca" hidden data-search-clear>Limpar</button>
      <button class="search-close" type="button" aria-label="Fechar busca" data-search-close>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m6 6 12 12M18 6 6 18"></path></svg>
      </button>
    </form>
    <p class="search-status" role="status" aria-live="polite" data-search-status>Digite para buscar no site.</p>
    <ul id="site-search-results" class="search-results" role="listbox" aria-label="Resultados da busca" data-search-results></ul>
    <p class="search-hint">Use ↑ e ↓ para navegar · Enter para abrir · Esc para fechar</p>
  </div>
</dialog>

<script>
  const trigger = document.querySelector<HTMLButtonElement>('[data-search-open]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-search-close]');
  const clearButton = document.querySelector<HTMLButtonElement>('[data-search-clear]');
  const status = document.querySelector<HTMLElement>('[data-search-status]');
  const resultsList = document.querySelector<HTMLUListElement>('[data-search-results]');

  if (trigger && dialog && input && closeButton && clearButton && status && resultsList) {
    type PagefindResult = { data: () => Promise<{ url: string; meta?: { title?: string } }> };
    type Pagefind = { init: () => Promise<void>; search: (query: string) => Promise<{ results: PagefindResult[] }> };

    let pagefindPromise: Promise<Pagefind> | undefined;
    let debounceTimer: number | undefined;
    let activeIndex = -1;
    let returnFocus: HTMLElement | null = null;
    let previousOverflow = '';

    const loadPagefind = () => {
      if (!pagefindPromise) {
        const base = dialog.dataset.base || '/';
        const scriptUrl = new URL(`${base.replace(/^\/+|\/+$/g, '')}/pagefind/pagefind.js`.replace(/^\//, ''), window.location.origin + '/');
        pagefindPromise = import(/* @vite-ignore */ scriptUrl.href).then(async (module) => {
          const engine = module as Pagefind;
          await engine.init();
          return engine;
        });
      }
      return pagefindPromise;
    };

    const setStatus = (message: string) => { status.textContent = message; };
    const setExpanded = (expanded: boolean) => input.setAttribute('aria-expanded', String(expanded));
    const setActive = (index: number) => {
      const options = [...resultsList.querySelectorAll<HTMLElement>('[role="option"]')];
      if (!options.length) return;
      activeIndex = (index + options.length) % options.length;
      options.forEach((option, i) => {
        option.setAttribute('aria-selected', String(i === activeIndex));
        option.classList.toggle('is-active', i === activeIndex);
      });
      input.setAttribute('aria-activedescendant', options[activeIndex].id);
      options[activeIndex].scrollIntoView({ block: 'nearest' });
    };

    const runSearch = async () => {
      const query = input.value.trim();
      clearButton.hidden = !query;
      resultsList.replaceChildren();
      setExpanded(false);
      activeIndex = -1;
      input.removeAttribute('aria-activedescendant');
      if (query.length < 2) {
        setStatus(query ? 'Digite pelo menos 2 caracteres.' : 'Digite para buscar no site.');
        return;
      }

      setStatus('Buscando…');
      try {
        const pagefind = await loadPagefind();
        const { results } = await pagefind.search(query);
        const pages = await Promise.all(results.slice(0, 8).map((result) => result.data()));
        if (!pages.length) {
          setStatus('Nenhum resultado encontrado.');
          return;
        }
        pages.forEach((page, index) => {
          const item = document.createElement('li');
          const link = document.createElement('a');
          const title = document.createElement('span');
          const arrow = document.createElement('span');
          item.id = `site-search-result-${index}`;
          item.setAttribute('role', 'option');
          item.setAttribute('aria-selected', 'false');
          link.href = page.url;
          title.textContent = page.meta?.title || 'Página';
          arrow.className = 'result-arrow';
          arrow.setAttribute('aria-hidden', 'true');
          arrow.textContent = '→';
          link.append(title, arrow);
          item.append(link);
          resultsList.append(item);
        });
        setExpanded(true);
        setStatus(`${pages.length} ${pages.length === 1 ? 'resultado' : 'resultados'}.`);
      } catch (error) {
        console.error('Falha ao carregar a busca do site.', error);
        setStatus('Não foi possível carregar a busca. Tente novamente.');
      }
    };

    const scheduleSearch = () => {
      window.clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(runSearch, 220);
    };

    const openDialog = () => {
      if (dialog.open) return;
      returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : trigger;
      previousOverflow = document.body.style.overflow;
      trigger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      dialog.showModal();
      input.focus();
    };

    const closeDialog = () => {
      if (dialog.open) dialog.close();
    };

    trigger.addEventListener('click', openDialog);
    closeButton.addEventListener('click', closeDialog);
    clearButton.addEventListener('click', () => {
      input.value = '';
      input.focus();
      void runSearch();
    });
    input.addEventListener('input', scheduleSearch);
    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') { event.preventDefault(); setActive(activeIndex + 1); }
      if (event.key === 'ArrowUp') { event.preventDefault(); setActive(activeIndex - 1); }
      if (event.key === 'Enter' && activeIndex >= 0) {
        const active = resultsList.querySelector<HTMLElement>(`#site-search-result-${activeIndex} a`);
        if (active) { event.preventDefault(); window.location.assign(active.href); }
      }
    });
    dialog.addEventListener('click', (event) => { if (event.target === dialog) closeDialog(); });
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        closeDialog();
      }
    });
    dialog.addEventListener('close', () => {
      trigger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = previousOverflow;
      returnFocus?.focus();
    });
    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        const target = event.target;
        const editing = target instanceof HTMLElement && (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName));
        if (!editing) { event.preventDefault(); openDialog(); }
      }
    });
  }
</script>

<style>
  .search-trigger { display: inline-grid; width: 44px; height: 44px; place-items: center; border: 1px solid var(--line); border-radius: 999px; padding: 0; background: transparent; color: var(--ink); cursor: pointer; }
  .search-trigger svg, .search-form > svg { width: 1.15rem; height: 1.15rem; flex: 0 0 auto; }
  .search-trigger:hover, .search-trigger:focus-visible, .search-close:hover, .search-close:focus-visible, .search-clear:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .search-dialog { width: min(42rem, calc(100vw - 2rem)); max-width: none; max-height: min(84dvh, 48rem); padding: 0; border: 1px solid var(--line); border-radius: 1rem; background: var(--surface); color: var(--ink); box-shadow: 0 1.5rem 5rem #0004; overflow: hidden; }
  .search-dialog::backdrop { background: #17171799; backdrop-filter: blur(3px); }
  .search-panel { display: flex; max-height: min(84dvh, 48rem); flex-direction: column; }
  .search-form { display: flex; align-items: center; gap: .8rem; padding: 1rem 1.15rem; border-bottom: 1px solid var(--line); }
  .search-form input { min-width: 0; flex: 1; border: 0; outline: 0; background: transparent; color: var(--ink); font: inherit; font-size: 1rem; }
  .search-form input::placeholder { color: var(--muted); }
  .search-close { display: grid; width: 2.3rem; height: 2.3rem; place-items: center; border: 0; border-radius: .5rem; background: transparent; color: var(--ink); cursor: pointer; }
  .search-close svg { width: 1.25rem; height: 1.25rem; }
  .search-clear { border: 0; background: transparent; color: var(--accent-dark); font: inherit; font-size: .8rem; cursor: pointer; }
  .search-status { margin: 0; padding: 1rem 1.25rem .4rem; color: var(--muted); font-size: .84rem; }
  .search-results { display: grid; gap: .5rem; margin: 0; padding: .5rem; overflow-y: auto; list-style: none; }
  .search-results:empty { display: none; }
  .search-results :global(li) { border: 1px solid var(--line); border-radius: .65rem; background: var(--paper); }
  .search-results :global(li.is-active), .search-results :global(li:hover), .search-results :global(li:focus-within) { border-color: var(--accent-dark); background: color-mix(in srgb, var(--accent) 9%, var(--paper)); }
  .search-results :global(a) { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .8rem .85rem; color: inherit; font-weight: 700; text-decoration: none; }
  .search-results :global(a:focus-visible) { outline: var(--focus-outline); outline-offset: -3px; border-radius: .6rem; }
  .search-results :global(.result-arrow) { flex: 0 0 auto; color: var(--accent-dark); }
  .search-hint { margin: 0; padding: .75rem 1.2rem; border-top: 1px solid var(--line); color: var(--muted); font-size: .72rem; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 700px) {
    .search-dialog { width: calc(100vw - 1rem); max-height: 86dvh; border-radius: .8rem; }
    .search-panel { max-height: 86dvh; }
    .search-form { gap: .55rem; padding: .8rem; }
    .search-form input { font-size: .9rem; }
  }
  @media (prefers-reduced-motion: reduce) { .search-dialog { scroll-behavior: auto; } }
</style>
