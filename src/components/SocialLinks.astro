---
interface Props {
  variant: 'header' | 'footer';
}

const { variant } = Astro.props;
const links = [
  {
    name: 'Instagram',
    href: 'https://www.instagram.com/odisseiamundana?psln=NnNxN3B2MDhudmJv&utm_source=qr',
    external: true,
    icon: 'instagram',
  },
  {
    name: 'YouTube',
    href: 'https://youtube.com/@odisseiamundana?si=0R9OUy1RS1AF23V_',
    external: true,
    icon: 'youtube',
  },
  {
    name: 'Email',
    href: 'mailto:odisseiamundana@gmail.com',
    external: false,
    icon: 'email',
  },
];

---

<div class:list={['social-links', `social-links--${variant}`]} aria-label="Redes sociais e contato">
  {links.map(({ name, href, external, icon }) => (
    <a
      class="social-link"
      href={href}
      aria-label={variant === 'header' ? name : undefined}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener noreferrer' : undefined}
    >
      <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        {icon === 'instagram' && (
          <>
            <rect x="3.25" y="3.25" width="17.5" height="17.5" rx="5" fill="none" stroke="currentColor" stroke-width="1.8" />
            <circle cx="12" cy="12" r="4.1" fill="none" stroke="currentColor" stroke-width="1.8" />
            <circle cx="17.65" cy="6.55" r="1.15" fill="currentColor" />
          </>
        )}
        {icon === 'youtube' && (
          <>
            <path d="M23.1 7.05a3 3 0 0 0-2.1-2.12C19.15 4.42 12 4.42 12 4.42s-7.15 0-9 .51A3 3 0 0 0 .9 7.05 31.2 31.2 0 0 0 .4 12a31.2 31.2 0 0 0 .5 4.95 3 3 0 0 0 2.1 2.12c1.85.51 9 .51 9 .51s7.15 0 9-.51a3 3 0 0 0 2.1-2.12 31.2 31.2 0 0 0 .5-4.95 31.2 31.2 0 0 0-.5-4.95Z" fill="currentColor" />
            <path d="m9.75 15.45 5.95-3.45-5.95-3.45v6.9Z" fill="var(--paper)" />
          </>
        )}
        {icon === 'email' && (
          <>
            <rect x="2.5" y="4.5" width="19" height="15" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.8" />
            <path d="m3.5 6 8.5 6.5L20.5 6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
          </>
        )}
      </svg>
      {variant === 'footer' && (
        <span class="social-link-label">{name}</span>
      )}
    </a>
  ))}
</div>
