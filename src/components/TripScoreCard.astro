---
import { buildTripScore, formatTripRating, TRIP_RATING_SCALE_MAX } from '../lib/tripScore.mjs';

interface Props {
  tripCard?: {
    overall_rating?: number;
    ratings?: Record<string, number>;
  };
}

const score = buildTripScore(Astro.props.tripCard);
---

{score && (
  <section class:list={['trip-score', { 'has-ratings': score.ratings.length > 0 }]} aria-labelledby="trip-score-title">
    <header class="trip-score-header">
      <h2 class="trip-score-title" id="trip-score-title">Avaliação da viagem</h2>
      <p class="trip-score-intro">Nossa impressão pessoal desta viagem, em notas de 1 a {TRIP_RATING_SCALE_MAX}.</p>
      {score.overall !== undefined && (
        <p class="trip-score-overall">
          <span class="trip-score-overall-label">Nota geral</span>
          <span class="trip-score-overall-value">{score.overall}<span class="trip-score-scale">/{TRIP_RATING_SCALE_MAX}</span></span>
        </p>
      )}
    </header>
    {score.ratings.length > 0 && (
      <ul class="trip-score-list">
        {score.ratings.map((rating) => (
          <li class="trip-score-item">
            <span class="trip-score-name">{rating.label}</span>
            <span class="trip-score-value">{formatTripRating(rating.value)}</span>
            <span class="trip-score-bar" aria-hidden="true">
              <span style={`width: ${(rating.value / TRIP_RATING_SCALE_MAX) * 100}%`}></span>
            </span>
          </li>
        ))}
      </ul>
    )}
  </section>
)}

<style>
  .trip-score { display: grid; gap: var(--space-5); max-width: var(--content-reading); margin: 44px auto 0; padding: var(--space-5); background: var(--surface); }
  .trip-score.has-ratings { grid-template-columns: minmax(0, 230px) minmax(0, 1fr); gap: var(--space-6); }
  .trip-score-title { margin: 0 0 var(--space-1); font-family: var(--font-display); font-size: clamp(26px, 3vw, 32px); font-weight: 400; letter-spacing: -.015em; line-height: 1.1; }
  .trip-score-intro { margin: 0; color: var(--muted); font-size: var(--text-sm); line-height: 1.6; }
  .trip-score-overall { display: grid; gap: var(--space-1); margin: var(--space-4) 0 0; padding-top: var(--space-3); border-top: 1px solid var(--copper); }
  .trip-score-overall-label { color: var(--nautical); font-size: var(--text-xs); font-weight: 800; letter-spacing: .18em; text-transform: uppercase; }
  .trip-score-overall-value { color: var(--ink); font-size: 56px; font-weight: 300; letter-spacing: -.03em; line-height: 1; font-variant-numeric: tabular-nums; }
  .trip-score-scale { margin-left: 2px; color: var(--dim); font-size: 22px; font-weight: 500; letter-spacing: 0; }
  .trip-score-list { display: grid; gap: var(--space-3); margin: 0; padding: 0; list-style: none; align-self: center; }
  .trip-score-item { display: grid; grid-template-columns: minmax(0, 1fr) auto; row-gap: 6px; align-items: baseline; }
  .trip-score-name { color: var(--ink); font-size: var(--text-base); font-weight: 600; }
  .trip-score-value { color: var(--muted); font-size: var(--text-sm); font-weight: 700; font-variant-numeric: tabular-nums; }
  .trip-score-bar { grid-column: 1 / -1; display: block; height: 3px; background: var(--line); }
  .trip-score-bar span { display: block; height: 100%; background: var(--copper); }

  @media (max-width: 700px) {
    .trip-score, .trip-score.has-ratings { grid-template-columns: 1fr; gap: var(--space-4); padding: var(--space-4); }
    .trip-score-overall-value { font-size: 48px; }
  }
</style>
