---
import { getCollection, getEntry, render } from 'astro:content';
import { resolve } from 'node:path';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import CostTable from '../../../components/CostTable.astro';
import CostTableFrame from '../../../components/CostTableFrame.astro';
import VideoCarousel from '../../../components/VideoCarousel.astro';
import { loadMotorhomePlaylist } from '../../../lib/motorhomePlaylist.mjs';
import { buildProjectCostRows, formatMotorhomeMoney as formatMoney } from '../../../lib/motorhomeCosts.mjs';

export async function getStaticPaths() {
  const pages = await getCollection('motorhomeProjectPages');
  const visiblePages = pages.filter((entry) => entry.data.status === 'published' || import.meta.env.DEV);
  return Promise.all(visiblePages.map(async (entry) => {
    const metadata = await getEntry(entry.data.project_id);
    if (!metadata || metadata.id !== metadata.data.project_id) {
      throw new Error(`Metadados de motorhome ausentes ou com identificador divergente: ${entry.data.project_id.id}`);
    }
    const videos = await loadMotorhomePlaylist(metadata.data, resolve('imports', 'youtube', 'channel'));
    return { params: { projectId: metadata.id }, props: { entry, project: metadata.data, videos } };
  }));
}

const { entry, project, videos } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const isDraft = entry.data.status !== 'published';
const ledgerRows = buildProjectCostRows(project.cost_items ?? []);
const initialLedgerRows = ledgerRows.slice(0, 10);
const costs = project.main_costs ?? [];
const currencies = new Set(costs.map((cost) => cost.currency));
if (currencies.size > 1) throw new Error('O gráfico de custos exige valores na mesma moeda, sem conversão automática.');
const totalCents = costs.reduce((sum, cost) => sum + Math.round(cost.amount * 100), 0);
const costColors = ['var(--nautical)', 'var(--accent-dark)', 'var(--gold)'];
const percentageFormat = new Intl.NumberFormat('pt-BR', { style: 'percent', maximumFractionDigits: 1 });
let accumulatedCents = 0;
const rows = costs.map((cost, index) => {
  const start = totalCents > 0 ? accumulatedCents / totalCents * 100 : 0;
  accumulatedCents += Math.round(cost.amount * 100);
  const end = totalCents > 0 ? accumulatedCents / totalCents * 100 : 0;
  return {
    item: cost.description,
    detail: cost.unit,
    amount: formatMoney(cost.amount, cost.currency),
    color: costColors[index % costColors.length],
    start,
    end,
    percentage: totalCents > 0 ? percentageFormat.format((end - start) / 100) : undefined,
  };
});
const pieBackground = totalCents > 0
  ? `conic-gradient(${rows.map((row) => `${row.color} ${row.start}% ${row.end}%`).join(', ')})`
  : 'var(--surface)';
const videoById = new Map(videos.map((video) => [video.videoId, video]));
const systemPages = await getCollection('motorhomeSystemPages', (page) =>
  page.data.project_id.id === project.project_id && (page.data.status === 'published' || import.meta.env.DEV));
const pageBySystemId = new Map(systemPages.flatMap((page) =>
  page.data.system_ids.map((systemId) => [systemId, page.data.page_id] as const)));
const systems = (project.systems ?? []).map((system) => ({
  ...system,
  pageHref: pageBySystemId.has(system.system_id)
    ? `${base}pt/motorhomes/${project.project_id}/${pageBySystemId.get(system.system_id)}/` : undefined,
  videos: (system.video_ids ?? []).map((videoId) => {
    const video = videoById.get(videoId);
    if (!video) throw new Error(`Vídeo do sistema "${system.system_id}" ausente da sequência: ${videoId}`);
    return video;
  }),
}));
const systemGroups = [
  { field: 'equipment', title: 'Equipamentos' },
  { field: 'materials', title: 'Materiais' },
  { field: 'tools', title: 'Ferramentas' },
  { field: 'technologies', title: 'Tecnologias' },
];
---

<SiteLayout title={entry.data.title} description={project.summary}>
  {isDraft && <meta slot="head" name="robots" content="noindex, nofollow" />}
  <article class="story-page motorhome-project">
    {isDraft && <p class="eyebrow">Prévia local · não publicada</p>}
    <header class="story-header">
      <h1>{entry.data.title}</h1>
      {project.summary && <p class="project-intro">{project.summary}</p>}
    </header>

    <VideoCarousel title="Acompanhe a construção" description="Reunimos os vídeos da construção e os conteúdos complementares na sequência da nossa playlist." videos={videos} playlistId={project.playlist_id} />

    <div class="story-body project-story"><Content /></div>

    <section class="project-section" aria-labelledby="systems-title">
      <p class="eyebrow">Por dentro do projeto</p>
      <h2 id="systems-title">Sistemas e etapas</h2>
      <p class="section-intro">Do isolamento à cozinha, organizamos aqui os materiais, equipamentos e vídeos de cada parte da nossa casa sobre rodas.</p>
      <div class="project-systems">
        {systems.map((system) => (
          <details>
            <summary>{system.title}</summary>
            <div class="system-content">
              {system.pageHref && <p><a class="text-link" href={system.pageHref}>Conhecer esta etapa →</a></p>}
              {systemGroups.map(({ field, title }) => system[field]?.length > 0 && (
                <div>
                  <h3>{title}</h3>
                  <ul>{system[field].map((item: string) => <li>{item}</li>)}</ul>
                </div>
              ))}
              <h3>Vídeos sobre este tema</h3>
              <ul class="system-video-links">
                {system.videos.map((video) => (
                  <li><a href={`#video-${video.videoId}`}>{video.title}</a></li>
                ))}
              </ul>
            </div>
          </details>
        ))}
      </div>
    </section>

    <section id="construction-costs" class="project-section project-costs" aria-labelledby="costs-title">
      <p class="eyebrow">Nossas contas</p>
      <h2 id="costs-title">Planilha de custos completa</h2>
      <p class="section-intro">Reunimos a compra e as despesas da van, a manutenção e as demais categorias. O total não representa apenas a conversão: também inclui gastos de manutenção posteriores ao fim da construção.</p>
      {ledgerRows.length > 0 && (
        <div class="project-ledger">
          <CostTableFrame id="project-cost-ledger" label="Planilha de gastos: role para percorrer os itens carregados.">
            <CostTable
              caption="Nossos lançamentos de 2018/2019, na ordem da planilha original — valores históricos, não são preços atuais."
              amountLabel="Valor registrado"
              rows={initialLedgerRows}
            />
          </CostTableFrame>
          <div class="ledger-controls">
            <p data-ledger-status role="status">{initialLedgerRows.length} de {ledgerRows.length} itens carregados.</p>
            {ledgerRows.length > initialLedgerRows.length && (
              <button class="button" type="button" data-load-costs data-source={`${base}pt/motorhomes/${project.project_id}/costs.json`} data-total={ledgerRows.length} aria-controls="project-cost-ledger" hidden>
                Ver mais 10 itens
              </button>
            )}
          </div>
          <noscript><p>Para consultar todos os lançamentos, baixe a planilha completa no link abaixo.</p></noscript>
        </div>
      )}
      {rows.length > 0 && (
        <figure class="cost-summary" aria-label="Distribuição dos custos registrados">
          <figcaption>Valores históricos registrados na nossa planilha de 2018/2019, em reais — não são preços atuais.</figcaption>
          <div class="cost-distribution">
            <div class="cost-pie" style={{ background: pieBackground }} aria-hidden="true"></div>
            <ul class="cost-legend" role="list">
              {rows.map((row) => (
                <li>
                  <span class="cost-swatch" style={{ background: row.color }} aria-hidden="true"></span>
                  <div>
                    <strong>{row.item}</strong>
                    <p class="cost-value">{row.amount}{row.percentage && <span> · {row.percentage}</span>}</p>
                    <p class="cost-detail">{row.detail}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
          <p class="cost-total"><span>Total registrado</span><strong>{formatMoney(totalCents / 100, costs[0].currency)}</strong></p>
        </figure>
      )}
      {project.downloads?.length > 0 && (
        <div class="project-download">
          <h3>Nossa planilha para você</h3>
          <p>Disponibilizamos uma cópia da planilha original, com os itens e valores que registramos na época.</p>
          {project.downloads.map((file) => (
            <a class="button" href={`${base}${file.path}`} download>{file.title}</a>
          ))}
        </div>
      )}
    </section>
  </article>
</SiteLayout>

<script>
  interface CostRow {
    item: string;
    detail?: string;
    amount: string;
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-load-costs]')) {
    const frame = document.querySelector<HTMLElement>('#project-cost-ledger');
    const tbody = frame?.querySelector('tbody');
    const status = document.querySelector<HTMLElement>('[data-ledger-status]');
    const source = button.dataset.source;
    const total = Number(button.dataset.total);
    if (!frame || !tbody || !status || !source || !Number.isInteger(total) || total < tbody.rows.length) {
      throw new Error('Elementos ou dados de carregamento da planilha ausentes ou inválidos.');
    }
    let rows: CostRow[] | undefined;
    button.hidden = false;

    button.addEventListener('click', async () => {
      button.disabled = true;
      button.textContent = 'Carregando…';
      frame.setAttribute('aria-busy', 'true');
      try {
        if (!rows) {
          const response = await fetch(source);
          if (!response.ok) throw new Error(`Falha ao carregar os gastos: HTTP ${response.status}`);
          const data: unknown = await response.json();
          if (!Array.isArray(data) || data.length !== total) throw new Error('Quantidade de lançamentos divergente.');
          rows = data.map((row) => {
            if (!row || typeof row.item !== 'string' || typeof row.amount !== 'string'
              || (row.detail !== undefined && typeof row.detail !== 'string')) {
              throw new Error('Lançamento de custo inválido.');
            }
            return { item: row.item, detail: row.detail, amount: row.amount };
          });
        }
        const previousCount = tbody.rows.length;
        const fragment = document.createDocumentFragment();
        for (const row of rows.slice(previousCount, previousCount + 10)) {
          const tr = document.createElement('tr');
          const item = document.createElement('th');
          item.scope = 'row';
          item.textContent = row.item;
          if (row.detail) {
            const detail = document.createElement('span');
            detail.className = 'cost-table-detail';
            detail.textContent = row.detail;
            item.append(detail);
          }
          const amount = document.createElement('td');
          amount.textContent = row.amount;
          tr.append(item, amount);
          fragment.append(tr);
        }
        tbody.append(fragment);
        status.textContent = `${tbody.rows.length} de ${total} itens carregados.`;
        button.hidden = tbody.rows.length === total;
        const firstAdded = tbody.rows[previousCount];
        frame.scrollTop += firstAdded.getBoundingClientRect().top - frame.getBoundingClientRect().top - frame.clientTop;
      } catch (error) {
        console.error('Não foi possível carregar mais lançamentos da planilha.', error);
        status.textContent = `Não foi possível carregar mais itens. Os ${tbody.rows.length} já carregados continuam disponíveis. Tente novamente ou baixe a planilha completa.`;
      } finally {
        frame.removeAttribute('aria-busy');
        button.disabled = false;
        button.textContent = `Ver mais ${Math.min(10, total - tbody.rows.length)} itens`;
      }
    });
  }
</script>

<style>
  .motorhome-project { padding-top: var(--space-6); }
  .motorhome-project > .eyebrow { margin-bottom: var(--space-5); }
  .project-intro { max-width: var(--content-reading); margin: var(--space-5) 0 0; color: var(--muted); font-size: 18px; line-height: 1.8; }
  .project-section { margin-top: var(--space-section); }
  .project-section h2 { margin: 0 0 var(--space-3); font: 400 clamp(30px, 4vw, 44px)/1.15 var(--font-display); letter-spacing: -.02em; }
  .section-intro { max-width: var(--content-reading); margin-bottom: var(--space-5); color: var(--muted); font-size: 16px; line-height: 1.8; }
  .project-story { margin-top: var(--space-section); }
  .project-systems details { border-bottom: 1px solid var(--line); }
  .project-systems summary { padding: var(--space-4) 0; font-size: 17px; font-weight: 700; cursor: pointer; }
  .project-systems summary::marker { color: var(--accent-dark); }
  .project-systems summary:focus-visible { outline: var(--focus-outline); outline-offset: 4px; }
  .system-content { max-width: var(--content-reading); padding: 0 0 var(--space-4) var(--space-4); color: var(--muted); font-size: 15px; line-height: 1.8; }
  .system-content h3 { margin: var(--space-4) 0 var(--space-1); color: var(--ink); font-size: 14px; }
  .system-content ul { padding-left: 1.2em; }
  .system-video-links a { color: var(--accent-dark); text-decoration: underline; text-underline-offset: .2em; }
  .project-costs { max-width: var(--content-reading); margin-right: auto; margin-left: auto; scroll-margin-top: var(--space-4); }
  .project-ledger { margin-bottom: var(--space-5); }
  .ledger-controls { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-3); }
  .ledger-controls p { margin: 0; color: var(--muted); font-size: 13px; }
  .ledger-controls button { cursor: pointer; }
  .ledger-controls button:disabled { opacity: .6; cursor: wait; }
  .ledger-controls button[hidden] { display: none; }
  .cost-summary { margin: 0; }
  .cost-summary figcaption { margin-bottom: var(--space-4); color: var(--muted); font-size: var(--text-sm); line-height: 1.6; }
  .cost-distribution { display: grid; grid-template-columns: minmax(0, 260px) minmax(0, 1fr); align-items: center; gap: var(--space-5); }
  .cost-pie { width: 100%; aspect-ratio: 1; border-radius: 50%; }
  .cost-legend { display: grid; gap: var(--space-4); margin: 0; padding: 0; list-style: none; font-size: var(--text-base); line-height: 1.5; }
  .cost-legend li { display: grid; grid-template-columns: 12px minmax(0, 1fr); gap: var(--space-2); }
  .cost-swatch { width: 12px; height: 12px; margin-top: 5px; border-radius: var(--radius-small); }
  .cost-value { margin: 4px 0; font-weight: 600; font-variant-numeric: tabular-nums; }
  .cost-value span { color: var(--muted); font-weight: 500; }
  .cost-detail { margin: 0; color: var(--muted); font-size: 13px; }
  .cost-total { display: flex; justify-content: space-between; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-4) 0 0; padding-top: var(--space-3); border-top: 1px solid var(--line); color: var(--nautical); font: 400 24px/1.3 var(--font-display); }
  .cost-total strong { font-weight: 400; }
  .project-download { margin-top: var(--space-5); padding: var(--space-5); background: var(--surface); }
  .project-download h3 { margin: 0 0 var(--space-2); font: 400 28px/1.2 var(--font-display); }
  .project-download p { color: var(--muted); font-size: 15px; line-height: 1.8; }
  .project-download .button { max-width: 100%; padding: var(--space-3) var(--space-4); text-align: center; line-height: 1.5; }
  @media (max-width: 700px) {
    .project-section { margin-top: var(--space-6); }
    .cost-distribution { grid-template-columns: minmax(0, 1fr); }
    .cost-pie { max-width: 260px; justify-self: center; }
    .project-download { padding: var(--space-4); }
  }
</style>
