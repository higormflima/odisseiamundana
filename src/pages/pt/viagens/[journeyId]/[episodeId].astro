---
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import YouTubeVideo from '../../../../components/YouTubeVideo.astro';
import TripScoreCard from '../../../../components/TripScoreCard.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { assertJourneyReferences } from '../../../../lib/journeyReferences.mjs';

export async function getStaticPaths() {
  const pages = await getCollection('journeyPages');
  const journeys = await getCollection('journeyMetadata');
  assertJourneyReferences(
    pages.map((entry) => ({ pageId: entry.id, journeyId: entry.data.journey_id.id })),
    journeys.map((journey) => journey.id),
  );

  return pages.filter((entry) => entry.data.status === 'published' || import.meta.env.DEV).map((entry) => ({
    params: { journeyId: entry.data.journey_id.id, episodeId: entry.data.episode_id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const metadataEntry = await getEntry(entry.data.journey_id);
if (!metadataEntry) {
  throw new Error(`A página editorial "${entry.id}" referencia uma viagem inexistente: "${entry.data.journey_id.id}".`);
}
const journeyTitle = metadataEntry.data.title ?? entry.data.title;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<SiteLayout title={entry.data.title} description={journeyTitle}>
  <article class="story-page">
    {import.meta.env.DEV && entry.data.status !== 'published' && (
      <p class="eyebrow">Prévia local · não publicada</p>
    )}
    <a class="back-link" href={`${base}pt/viagens/`}>← Todas as viagens</a>
    <header class="story-header">
      <p class="eyebrow">{journeyTitle}</p>
      <h1>{entry.data.title}</h1>
    </header>
    {entry.data.youtube_video_id && <YouTubeVideo videoId={entry.data.youtube_video_id.id} title={entry.data.title} />}
    <TripScoreCard tripCard={metadataEntry.data.trip_card} />
    <div class="story-body"><Content /></div>
  </article>
</SiteLayout>
