---
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import YouTubeVideo from '../../../../components/YouTubeVideo.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('journeyPages', ({ data }) => data.status === 'published');
  return pages.map((entry) => ({
    params: { journeyId: entry.data.journey_id, episodeId: entry.data.episode_id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const metadataEntries = await getCollection('journeyMetadata');
const metadataEntry = metadataEntries.find((item) => item.id === entry.data.journey_id);
const journeyTitle = metadataEntry?.data.title ?? entry.data.title;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<SiteLayout title={entry.data.title} description={journeyTitle}>
  <article class="story-page">
    <a class="back-link" href={`${base}pt/viagens/`}>← Todas as viagens</a>
    <header class="story-header">
      <p class="eyebrow">{journeyTitle}</p>
      <h1>{entry.data.title}</h1>
    </header>
    {entry.data.youtube_video_id && <YouTubeVideo videoId={entry.data.youtube_video_id} title={entry.data.title} />}
    <div class="story-body"><Content /></div>
  </article>
</SiteLayout>
