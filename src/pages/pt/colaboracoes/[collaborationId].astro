---
import { render } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import PhotoGallery from '../../../components/PhotoGallery.astro';
import YouTubeVideo from '../../../components/YouTubeVideo.astro';
import { loadCollaborations } from '../../../lib/collaborationCollection';
import { collaborationTypeLabels } from '../../../lib/collaborations.mjs';
import '../../../styles/collaborations.css';

export async function getStaticPaths() {
  const projects = await loadCollaborations();
  return projects.map((project) => ({ params: { collaborationId: project.collaboration_id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project.page);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const canonical = new URL(`${base}pt/colaboracoes/${project.collaboration_id}/`, Astro.site);
const title = `${project.title} | Colaborações | Odisseia Mundana`;
const photos = (project.photos ?? []).map((photo) => ({
  ...photo,
  src: `${base}${photo.src}`,
  thumbnail: `${base}${photo.thumbnail ?? photo.src}`,
}));
const videos = (project.videos ?? []).map((video) => ({
  ...video,
  thumbnailUrl: video.thumbnail ? `${base}${video.thumbnail}` : undefined,
}));
---
<SiteLayout title={project.title} fullTitle={title} description={project.description}>
  <Fragment slot="head">
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={project.description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL(`${base}${project.cover.src}`, Astro.site).href} />
    <meta property="og:image:alt" content={project.cover.alt} />
    {project.status !== 'published' && <meta name="robots" content="noindex, nofollow" />}
  </Fragment>
  <article class="collaboration-detail">
    <a class="back-link" href={`${base}pt/colaboracoes/`}>← Todas as colaborações</a>
    {import.meta.env.DEV && project.status !== 'published' && <p class="eyebrow">Prévia local · não publicada</p>}
    <header class="collaboration-hero">
      <div class="collaboration-hero-copy">
        <p class="eyebrow">{project.kind === 'example' ? 'Exemplo ilustrativo · ' : ''}{project.destination} · {project.country}</p>
        <h1>{project.title}</h1>
        <p>{project.description}</p>
      </div>
      <img src={`${base}${project.cover.src}`} alt={project.cover.alt} width={project.cover.width} height={project.cover.height} fetchpriority="high" decoding="async" />
    </header>
    {project.kind === 'example' && <p class="collaboration-example">Exemplo ilustrativo: estas fotografias são de uma viagem real, mas esta página não representa uma parceria realizada.</p>}
    <section class="collaboration-reading" aria-labelledby="experience-title">
      <h2 id="experience-title">Sobre a experiência</h2>
      <div class="collaboration-story"><Content /></div>
    </section>
    {project.partner && (
      <section class="collaboration-partner" aria-labelledby="partner-title">
        <div>
          <p class="eyebrow">Em parceria</p>
          <h2 id="partner-title">Nosso parceiro</h2>
          <h3>{project.partner.name}</h3>
          {project.partner.description && <p>{project.partner.description}</p>}
          {project.partner.address && <p><strong>Endereço</strong><br />{project.partner.address}</p>}
          <div class="collaboration-partner-links">
            {project.partner.website && <a class="text-link" href={project.partner.website} target="_blank" rel="noopener noreferrer">Site oficial ↗</a>}
            {project.partner.email && <a class="text-link" href={`mailto:${project.partner.email}`}>{project.partner.email}</a>}
            {project.partner.phone && <a class="text-link" href={`tel:${project.partner.phone}`}>{project.partner.phone}</a>}
            {project.partner.instagram && <a class="text-link" href={project.partner.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a>}
            {project.partner.whatsapp && <a class="text-link" href={`https://wa.me/${project.partner.whatsapp.replace(/\D/g, '')}`} target="_blank" rel="noopener noreferrer">WhatsApp: {project.partner.whatsapp} ↗</a>}
          </div>
        </div>
        {project.partner.logo && <img src={`${base}${project.partner.logo.src}`} alt={project.partner.logo.alt} width={project.partner.logo.width} height={project.partner.logo.height} loading="lazy" decoding="async" />}
      </section>
    )}
    {project.kind === 'example' && !project.partner && (
      <section class="collaboration-partner" aria-labelledby="example-partner-title">
        <div>
          <p class="eyebrow">Exemplo ilustrativo</p>
          <h2 id="example-partner-title">Nosso parceiro</h2>
          <p>Este exemplo não tem um parceiro associado. Em um projeto real, apresentaremos aqui a empresa e seus canais oficiais.</p>
        </div>
      </section>
    )}
    {(project.type || project.received?.length || project.delivered?.length) && (
      <section class="collaboration-reading" aria-labelledby="collaboration-title">
        <h2 id="collaboration-title">A colaboração</h2>
        {project.type && <p class="collaboration-type">{collaborationTypeLabels[project.type]}</p>}
        <div class="collaboration-exchange">
          {project.received?.length > 0 && <div><h3>O que recebemos</h3><ul>{project.received.map((item) => <li>{item}</li>)}</ul></div>}
          {project.delivered?.length > 0 && <div><h3>O que produzimos</h3><ul>{project.delivered.map((item) => <li>{item}</li>)}</ul></div>}
        </div>
      </section>
    )}
    {project.kind === 'example' && !project.type && (
      <section class="collaboration-reading" aria-labelledby="example-collaboration-title">
        <h2 id="example-collaboration-title">A colaboração</h2>
        <p>Em uma parceria, podemos combinar benefícios e entregas de acordo com cada projeto. Abaixo, apresentamos possibilidades ilustrativas, não uma parceria realizada.</p>
        <div class="collaboration-exchange">
          <div><h3>O que poderíamos receber</h3><p>Uma experiência ou serviço acordado com o parceiro.</p></div>
          <div><h3>O que poderíamos produzir</h3><p>Fotografias ou vídeos combinados para contar essa história.</p></div>
        </div>
      </section>
    )}
    {photos.length > 0 && <section class="collaboration-media"><PhotoGallery title="Fotografias" photos={photos} variant="featured" /></section>}
    {project.videos?.length > 0 && (
      <section class="collaboration-media" aria-labelledby="videos-title">
        <h2 id="videos-title">Conteúdo em vídeo</h2>
        <div class="collaboration-videos">{videos.map((video) => <YouTubeVideo videoId={video.id} title={video.title} thumbnailUrl={video.thumbnailUrl} />)}</div>
      </section>
    )}
    <div class="collaboration-detail-cta">
      <h2>Vamos contar novas histórias?</h2>
      <a class="text-link" href={`${base}pt/colaboracoes/#contato-comercial`}>Converse conosco sobre uma parceria →</a>
    </div>
  </article>
</SiteLayout>
