---
import SiteLayout from '../../layouts/SiteLayout.astro';

// Endereço antigo do Planejador Elétrico: redireciona preservando parâmetros (ex.: utm_source) e âncora.
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const newPath = `${base}pt/planejador-eletrico/`;
---

<SiteLayout title="Planejador Elétrico" description="O Planejador Elétrico mudou de endereço." canonicalPath={newPath} noindex>
  <meta http-equiv="refresh" content={`0;url=${newPath}`} slot="head" />
  <script is:inline slot="head" define:vars={{ newPath }}>
    window.location.replace(newPath + window.location.search + window.location.hash);
  </script>
  <section class="redirect-page">
    <p class="eyebrow">Planejador Elétrico</p>
    <h1>O Planejador Elétrico mudou de endereço.</h1>
    <a class="text-link" href={newPath}>Abrir o Planejador Elétrico <span aria-hidden="true">↗</span></a>
  </section>
</SiteLayout>
