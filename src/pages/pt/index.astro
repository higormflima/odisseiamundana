---
import SiteLayout from '../../layouts/SiteLayout.astro';
import InteractiveWorldMap from '../../components/InteractiveWorldMap.astro';
import { getCollection } from 'astro:content';
import { buildJourneyMapEntries, compareJourneysByRecency, formatJourneyListDate } from '../../lib/journeyMapData.mjs';
import { buildGalleryCollections } from '../../lib/galleryCollections.mjs';

const pages = await getCollection('journeyPages');
const journeys = await getCollection('journeyMetadata');
const publishedJourneyPages = pages.filter(
  (page) => page.data.status === 'published' && page.data.episode_id === 'journey-summary',
);
const draftPages = import.meta.env.DEV
  ? pages.filter((page) => page.data.status !== 'published' && page.data.episode_id === 'journey-summary')
  : [];
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const datesByJourney = new Map(journeys.map((journey) => [journey.id, journey.data.dates]));
const journeyDate = (page) => datesByJourney.get(page.data.journey_id.id);
const orderedPages = [...publishedJourneyPages].sort((left, right) => compareJourneysByRecency(journeyDate(left), journeyDate(right)));
const mapEntries = buildJourneyMapEntries({
  journeys,
  pages,
  videos: await getCollection('videoMetadata'),
  base,
});
const galleryCollections = buildGalleryCollections({ journeys, pages, base });
const homeGalleryPhotoPaths = [
  'media/journeys/philippines-palawan/photos/philippines-005.jpg',
  'media/journeys/finland-2026/photos/finland-010.jpg',
  'media/journeys/china-stopover/photos/china-007.jpg',
  'media/journeys/china-stopover/photos/china-006.jpg',
  'media/journeys/philippines-palawan/photos/philippines-021.jpg',
  'media/journeys/philippines-palawan/photos/philippines-004.jpg',
];
const availableGalleryPhotos = galleryCollections.flatMap((collection) => collection.photos);
const homeGalleryPhotos = homeGalleryPhotoPaths.flatMap((path) => {
  const photo = availableGalleryPhotos.find((item) => item.src === `${base}${path}`);
  return photo ? [photo] : [];
});
---

<SiteLayout title="Viagens" description="Histórias, roteiros e experiências de viagem.">
  <section class="home-hero">
    <div class="hero-copy">
      <p class="eyebrow">Odisseia Mundana · revista de viagens</p>
      <h1>O mundo, contado<br /><em>por quem o vive.</em></h1>
      <p class="hero-intro">Roteiros, encontros e histórias de lugares que ficam com a gente. Uma jornada contada em imagens e boas histórias.</p>
      <a class="text-link" href={mapEntries.length > 0 ? '#mapa' : '#viagens'}>Explore as viagens <span aria-hidden="true">↓</span></a>
    </div>
    <figure class="hero-portrait">
      <span class="hero-route" aria-hidden="true"></span>
      <img src={`${base}media/branding/optimized/hero-portrait.webp`} alt="Selfie do casal na neve, diante de uma casa de madeira e de montanhas nevadas" width="640" height="640" />
    </figure>
  </section>

  {mapEntries.length > 0 && (
    <section class="map-section" id="mapa" aria-labelledby="mapa-titulo">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Mapa de viagens</p>
          <h2 id="mapa-titulo">Explore pelo mapa</h2>
        </div>
        <p class="map-section-hint">Selecione um marcador para conhecer a viagem.</p>
      </div>
      <InteractiveWorldMap entries={mapEntries} skipTarget="#viagens" />
    </section>
  )}

  <section class="journeys-section" id="viagens">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Arquivo de viagens</p>
        <h2>Histórias pelo caminho</h2>
      </div>
      <span class="section-count">{publishedJourneyPages.length.toString().padStart(2, '0')} publicadas</span>
    </div>

    {publishedJourneyPages.length ? (
      <div class="journey-list">
        {orderedPages.map((page) => (
          <a class="journey-row" href={`${base}pt/viagens/${page.data.journey_id.id}/${page.data.episode_id}/`}>
            <span class="journey-date">{formatJourneyListDate(journeyDate(page))}</span>
            <span class="journey-title">{page.data.title}</span>
            <span class="journey-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <span class="empty-mark" aria-hidden="true">✳</span>
        <p>As primeiras histórias estão sendo preparadas.</p>
        <span>Em breve, novos caminhos por aqui.</span>
      </div>
    )}

    {draftPages.length > 0 && (
      <aside class="draft-note" aria-label="Prévia de desenvolvimento">
        <p class="eyebrow">Prévia local · não publicada</p>
        {draftPages.map((page) => (
          <p><a href={`${base}pt/viagens/${page.data.journey_id.id}/${page.data.episode_id}/`}>{page.data.title}</a> — aguardando revisão editorial</p>
        ))}
      </aside>
    )}
  </section>
  {homeGalleryPhotos.length > 0 && (
    <section class="home-gallery" aria-labelledby="home-gallery-title">
      <a class:list={['home-gallery-mosaic', { 'home-gallery-mosaic--six': homeGalleryPhotos.length === 6 }]} href={`${base}pt/galeria/`} aria-label="Explorar a galeria fotográfica">
        {homeGalleryPhotos.map((photo) => (
          <span class="home-gallery-tile">
            <img src={photo.thumbnail} alt="" width={photo.thumbnailSize?.width} height={photo.thumbnailSize?.height} loading="lazy" decoding="async" />
          </span>
        ))}
      </a>
      <div>
        <p class="eyebrow">Galeria fotográfica</p>
        <h2 id="home-gallery-title">Nossas viagens em imagens</h2>
        <p>Reunimos fotografias dos lugares e momentos que encontramos pelo caminho.</p>
        <a class="text-link" href={`${base}pt/galeria/`}>Explorar a galeria <span aria-hidden="true">→</span></a>
      </div>
    </section>
  )}
</SiteLayout>

<style>
  .home-gallery { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: clamp(24px, 5vw, 72px); padding: 0 var(--content-gutter) var(--space-section); }
  .home-gallery-mosaic { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
  .home-gallery-tile { display: block; min-width: 0; overflow: hidden; aspect-ratio: 1; }
  .home-gallery-tile img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .home-gallery-mosaic--six { grid-template-columns: repeat(4, minmax(0, 1fr)); grid-template-rows: repeat(3, minmax(0, 1fr)); aspect-ratio: 4 / 3; }
  .home-gallery-mosaic--six .home-gallery-tile { aspect-ratio: auto; }
  .home-gallery-mosaic--six .home-gallery-tile:nth-child(1) { grid-area: 1 / 1 / 2 / 3; }
  .home-gallery-mosaic--six .home-gallery-tile:nth-child(2) { grid-area: 2 / 1 / 3 / 3; }
  .home-gallery-mosaic--six .home-gallery-tile:nth-child(3) { grid-area: 3 / 1 / 4 / 3; }
  .home-gallery-mosaic--six .home-gallery-tile:nth-child(4) { grid-area: 1 / 3 / 3 / 4; }
  .home-gallery-mosaic--six .home-gallery-tile:nth-child(5) { grid-area: 1 / 4 / 3 / 5; }
  .home-gallery-mosaic--six .home-gallery-tile:nth-child(6) { grid-area: 3 / 3 / 4 / 5; }
  .home-gallery .eyebrow { margin-bottom: 12px; }
  .home-gallery h2 { margin: 0 0 18px; font: 400 clamp(32px, 4vw, 52px)/1.1 var(--font-display); letter-spacing: -.025em; }
  .home-gallery p:not(.eyebrow) { max-width: 430px; color: var(--muted); line-height: 1.8; }
  .home-gallery .text-link span { color: var(--copper); }
  @media (max-width: 760px) { .home-gallery { grid-template-columns: 1fr; } }
</style>
