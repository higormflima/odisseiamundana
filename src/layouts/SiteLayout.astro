---
import '../styles/global.css';
import SocialLinks from '../components/SocialLinks.astro';
import CookieConsent from '../components/CookieConsent.astro';
import SearchModal from '../components/SearchModal.astro';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  fullTitle?: string;
  description?: string;
  lang?: string;
  /** Imagem de compartilhamento (caminho relativo à raiz do site); usa o logotipo quando ausente. */
  image?: string;
}

interface NavigationLink {
  label: string;
  href: string;
  children?: NavigationLink[];
}

const { title, fullTitle, description = 'Histórias, roteiros e experiências de viagem.', lang = 'pt-BR', image } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const pageTitle = fullTitle ?? `${title} | Odisseia Mundana`;
const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const shareImageUrl = new URL(image ?? `${base}media/branding/optimized/logo-primary.png`, siteUrl).href;
const systemPages = await getCollection('motorhomeSystemPages', (page) =>
  page.data.project_id.id === 'iveco-daily-3510' && (page.data.status === 'published' || import.meta.env.DEV));
const ivecoChildren = [
  { label: 'Construção Iveco Daily', href: `${base}pt/motorhomes/iveco-daily-3510/` },
  ...systemPages.sort((left, right) => left.data.sort_order - right.data.sort_order).map((page) => ({
    label: page.data.title,
    href: `${base}pt/motorhomes/${page.data.project_id.id}/${page.data.page_id}/`,
  })),
  { label: 'Custos do Projeto', href: `${base}pt/motorhomes/iveco-daily-3510/#construction-costs` },
];
const [fiatOverview] = await getCollection('motorhomeProjectPages', (page) =>
  page.data.project_id.id === 'fiat-ducato-1997' && (page.data.status === 'published' || import.meta.env.DEV));
const fiatSystemPages = await getCollection('motorhomeSystemPages', (page) =>
  page.data.project_id.id === 'fiat-ducato-1997' && (page.data.status === 'published' || import.meta.env.DEV));
const motorhomeChildren: NavigationLink[] = [
  { label: 'Iveco Daily 35.10', href: `${base}pt/motorhomes/iveco-daily-3510/`, children: ivecoChildren },
  ...(fiatOverview ? [{
    label: 'Camper FIAT Ducato',
    href: `${base}pt/motorhomes/fiat-ducato-1997/`,
    children: [
      { label: 'Apresentação', href: `${base}pt/motorhomes/fiat-ducato-1997/` },
      ...fiatSystemPages.sort((left, right) => left.data.sort_order - right.data.sort_order).map((page) => ({
        label: page.data.title,
        href: `${base}pt/motorhomes/${page.data.project_id.id}/${page.data.page_id}/`,
      })),
    ],
  }] : []),
  { label: 'Planejador Elétrico', href: `${base}pt/odisseia-solar/` },
];
const navigationLinks: NavigationLink[] = [
  { label: 'Início', href: `${base}pt/` },
  { label: 'Viagens', href: `${base}pt/viagens/` },
  { label: 'Motorhome', href: `${base}pt/motorhomes/iveco-daily-3510/`, children: motorhomeChildren },
  { label: 'Galeria', href: `${base}pt/galeria/` },
  { label: 'Colaborações', href: `${base}pt/colaboracoes/` },
  { label: 'Sobre Nós', href: `${base}pt/sobre-nos/` },
  { label: 'Contato', href: 'mailto:contato@odisseiamundana.com' },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Odisseia Mundana" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={shareImageUrl} />
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="theme-color" content="#fefefe" />
    <link rel="icon" type="image/png" sizes="48x48" href={`${base}media/branding/optimized/favicon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied'
      });
    </script>
    <title>{pageTitle}</title>
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-brand">
        <a class="wordmark" href={`${base}pt/`} aria-label="Odisseia Mundana — início">
          <img src={`${base}media/branding/optimized/logo-primary.png`} alt="" width="54" height="54" />
          <span>ODISSEIA<br />MUNDANA</span>
        </a>
        <SocialLinks variant="header" />
      </div>
      <div class="header-actions">
        <nav class="desktop-navigation" aria-label="Navegação principal">
          {navigationLinks.map(({ label, href, children }) => children?.length ? (
            <details class="motorhome-navigation">
              <summary>{label} <span aria-hidden="true">▾</span></summary>
              <div class="motorhome-submenu">
                {children.map((child) => child.children?.length ? (
                  <details class="motorhome-navigation">
                    <summary>{child.label} <span aria-hidden="true">▾</span></summary>
                    <div class="motorhome-submenu">
                      {child.children.map((item) => <a href={item.href}>{item.label}</a>)}
                    </div>
                  </details>
                ) : <a href={child.href}>{child.label}</a>)}
              </div>
            </details>
          ) : <a href={href}>{label}</a>)}
          <span class="language-note">PT</span>
        </nav>
        <SearchModal base={base} />
        <details class="mobile-navigation" data-mobile-navigation>
          <summary aria-label="Menu de navegação">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <path d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </summary>
          <nav aria-label="Navegação principal">
            {navigationLinks.map(({ label, href, children }) => children?.length ? (
              <details class="motorhome-navigation">
                <summary>{label} <span aria-hidden="true">▾</span></summary>
                <div class="motorhome-submenu">
                  {children.map((child) => child.children?.length ? (
                    <details class="motorhome-navigation">
                      <summary>{child.label} <span aria-hidden="true">▾</span></summary>
                      <div class="motorhome-submenu">
                        {child.children.map((item) => <a href={item.href}>{item.label}</a>)}
                      </div>
                    </details>
                  ) : <a href={child.href}>{child.label}</a>)}
                </div>
              </details>
            ) : <a href={href}>{label}</a>)}
            <span class="language-note">PT</span>
          </nav>
        </details>
      </div>
    </header>
    <main data-pagefind-body>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-signature">
        <span>© 2026 Odisseia Mundana</span>
        <CookieConsent />
      </div>
      <section class="footer-contact" id="contato" aria-label="Redes sociais e contato">
        <a class="footer-about-link" href={`${base}pt/sobre-nos/`}>Sobre Nós</a>
        <a class="footer-about-link" href={`${base}pt/colaboracoes/`}>Colaborações</a>
        <SocialLinks variant="footer" />
      </section>
    </footer>
  </body>
</html>

<script>
  for (const dropdown of document.querySelectorAll<HTMLDetailsElement>('.motorhome-navigation')) {
    dropdown.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && dropdown.open) {
        dropdown.open = false;
        dropdown.querySelector('summary')?.focus();
        event.stopPropagation();
      }
    });
    dropdown.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) dropdown.open = false;
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !dropdown.contains(event.target)) dropdown.open = false;
    });
  }
  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-navigation]');
  if (menu) {
    const summary = menu.querySelector<HTMLElement>('summary');
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('nav a')) menu.open = false;
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        summary?.focus();
      }
    });
    window.matchMedia('(min-width: 1351px)').addEventListener('change', (event) => {
      if (event.matches) menu.open = false;
    });
  }
</script>

<style>
  .motorhome-navigation { position: relative; }
  .motorhome-navigation > summary { display: flex; align-items: center; gap: 6px; cursor: pointer; list-style: none; }
  .motorhome-navigation > summary::-webkit-details-marker { display: none; }
  .motorhome-navigation > summary:focus-visible { outline: var(--focus-outline); outline-offset: 5px; }
  .motorhome-submenu { position: absolute; top: 100%; left: 0; z-index: 20; display: flex; flex-direction: column; width: min(320px, calc(100vw - 48px)); max-height: 65vh; overflow-y: auto; padding: 8px; border: 1px solid var(--line); background: var(--paper); box-shadow: var(--shadow-soft); }
  .motorhome-submenu a { display: block; padding: 12px; font-size: 14px; line-height: 1.5; }
  .motorhome-submenu > .motorhome-navigation > summary { padding: 12px; font-size: 14px; line-height: 1.5; }
  .motorhome-submenu .motorhome-submenu { position: static; width: auto; max-height: none; margin: 0 12px; padding: 0 0 0 8px; border: 0; border-left: 1px solid var(--line); box-shadow: none; }
  @media (max-width: 1350px) {
    .site-header .mobile-navigation nav { max-width: calc(100vw - 24px); max-height: calc(100dvh - 112px); overflow-y: auto; }
    .site-header .mobile-navigation .motorhome-navigation > summary { display: flex; width: auto; height: auto; padding: 12px; border: 0; border-radius: 0; }
    .motorhome-submenu { position: static; width: auto; max-width: 260px; max-height: none; margin: 0 12px; padding: 0 0 0 8px; border: 0; border-left: 1px solid var(--line); box-shadow: none; }
  }
</style>
