---
import '../styles/global.css';
import SocialLinks from '../components/SocialLinks.astro';
import CookieConsent from '../components/CookieConsent.astro';
import SearchModal from '../components/SearchModal.astro';

interface Props {
  title: string;
  fullTitle?: string;
  description?: string;
  lang?: string;
}

const { title, fullTitle, description = 'Histórias, roteiros e experiências de viagem.', lang = 'pt-BR' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fefefe" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied'
      });
    </script>
    <title>{fullTitle ?? `${title} | Odisseia Mundana`}</title>
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={`${base}pt/`} aria-label="Odisseia Mundana — início">
        <img src={`${base}media/branding/optimized/logo-primary.png`} alt="" width="54" height="54" />
        <span>ODISSEIA<br />MUNDANA</span>
      </a>
      <nav aria-label="Navegação principal">
        <a href={`${base}pt/`}>Início</a>
        <a href={`${base}pt/viagens/`}>Viagens</a>
        <a href={`${base}pt/sobre-nos/`}>Sobre nós</a>
        <a href={`mailto:odisseiamundana@gmail.com`}>Contato</a>
        <span class="language-note">PT</span>
        <SearchModal base={base} />
        <SocialLinks variant="header" />
      </nav>
    </header>
    <main data-pagefind-body>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-signature">
        <span>Odisseia Mundana</span>
        <span>Histórias de lugares e caminhos.</span>
        <CookieConsent />
      </div>
      <section class="footer-contact" id="contato" aria-labelledby="footer-contact-title">
        <h2 id="footer-contact-title">Redes sociais e contato</h2>
        <a class="footer-about-link" href={`${base}pt/sobre-nos/`}>Sobre nós</a>
        <SocialLinks variant="footer" />
      </section>
    </footer>
  </body>
</html>
