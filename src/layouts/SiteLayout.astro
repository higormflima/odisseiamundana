---
import '../styles/global.css';
import SocialLinks from '../components/SocialLinks.astro';

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description = 'Histórias, roteiros e experiências de viagem.', lang = 'pt-BR' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fefefe" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title} | Odisseia Mundana</title>
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={`${base}pt/`} aria-label="Odisseia Mundana — início">
        <img src={`${base}media/branding/optimized/logo-primary.png`} alt="" width="54" height="54" />
        <span>ODISSEIA<br />MUNDANA</span>
      </a>
      <nav aria-label="Navegação principal">
        <a href={`${base}pt/viagens/`}>Viagens</a>
        <span class="language-note">PT</span>
        <SocialLinks variant="header" />
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-signature">
        <span>Odisseia Mundana</span>
        <span>Histórias de lugares e caminhos.</span>
      </div>
      <section class="footer-contact" aria-labelledby="footer-contact-title">
        <h2 id="footer-contact-title">Redes sociais e contato</h2>
        <SocialLinks variant="footer" />
      </section>
    </footer>
  </body>
</html>
