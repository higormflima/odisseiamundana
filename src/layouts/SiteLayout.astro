---
import '../styles/global.css';
import SocialLinks from '../components/SocialLinks.astro';
import CookieConsent from '../components/CookieConsent.astro';
import SearchModal from '../components/SearchModal.astro';

interface Props {
  title: string;
  fullTitle?: string;
  description?: string;
  lang?: string;
}

const { title, fullTitle, description = 'Histórias, roteiros e experiências de viagem.', lang = 'pt-BR' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const navigationLinks = [
  { label: 'Início', href: `${base}pt/` },
  { label: 'Viagens', href: `${base}pt/viagens/` },
  { label: 'Sobre nós', href: `${base}pt/sobre-nos/` },
  { label: 'Contato', href: 'mailto:odisseiamundana@gmail.com' },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fefefe" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied'
      });
    </script>
    <title>{fullTitle ?? `${title} | Odisseia Mundana`}</title>
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-brand">
        <a class="wordmark" href={`${base}pt/`} aria-label="Odisseia Mundana — início">
          <img src={`${base}media/branding/optimized/logo-primary.png`} alt="" width="54" height="54" />
          <span>ODISSEIA<br />MUNDANA</span>
        </a>
        <SocialLinks variant="header" />
      </div>
      <div class="header-actions">
        <nav class="desktop-navigation" aria-label="Navegação principal">
          {navigationLinks.map(({ label, href }) => <a href={href}>{label}</a>)}
          <span class="language-note">PT</span>
        </nav>
        <SearchModal base={base} />
        <details class="mobile-navigation" data-mobile-navigation>
          <summary aria-label="Menu de navegação">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <path d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </summary>
          <nav aria-label="Navegação principal">
            {navigationLinks.map(({ label, href }) => <a href={href}>{label}</a>)}
            <span class="language-note">PT</span>
          </nav>
        </details>
      </div>
    </header>
    <main data-pagefind-body>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-signature">
        <span>Odisseia Mundana</span>
        <span>Histórias de lugares e caminhos.</span>
        <CookieConsent />
      </div>
      <section class="footer-contact" id="contato" aria-labelledby="footer-contact-title">
        <h2 id="footer-contact-title">Redes sociais e contato</h2>
        <a class="footer-about-link" href={`${base}pt/sobre-nos/`}>Sobre nós</a>
        <SocialLinks variant="footer" />
      </section>
    </footer>
  </body>
</html>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-navigation]');
  if (menu) {
    const summary = menu.querySelector<HTMLElement>('summary');
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('nav a')) menu.open = false;
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        summary?.focus();
      }
    });
    window.matchMedia('(min-width: 1101px)').addEventListener('change', (event) => {
      if (event.matches) menu.open = false;
    });
  }
</script>
