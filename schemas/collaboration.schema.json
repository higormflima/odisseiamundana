{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metadados de colaboração",
  "type": "object",
  "additionalProperties": false,
  "required": ["collaboration_id", "status", "kind", "title", "description", "destination", "country", "cover"],
  "properties": {
    "collaboration_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "status": { "enum": ["draft", "published"] },
    "kind": { "enum": ["example", "project"] },
    "title": { "$ref": "#/$defs/text" },
    "description": { "$ref": "#/$defs/text" },
    "destination": { "$ref": "#/$defs/text" },
    "country": { "$ref": "#/$defs/text" },
    "date": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "month"],
      "properties": {
        "year": { "type": "integer", "minimum": 1900, "maximum": 9999 },
        "month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "day": { "type": "integer", "minimum": 1, "maximum": 31 }
      }
    },
    "cover": { "$ref": "#/$defs/photo" },
    "photos": { "type": "array", "items": { "$ref": "#/$defs/photo" } },
    "partner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "logo": { "$ref": "#/$defs/photo" },
        "website": { "$ref": "#/$defs/url" },
        "instagram": { "$ref": "#/$defs/url" }
      }
    },
    "type": { "enum": ["exchange", "sponsorship", "paid", "special"] },
    "received": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
    "delivered": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
    "videos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
          "title": { "$ref": "#/$defs/text" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "published" }, "kind": { "const": "project" } }, "required": ["status", "kind"] },
      "then": {
        "properties": { "date": true, "partner": true, "type": true, "received": true, "delivered": true },
        "required": ["date", "partner", "type", "received", "delivered"]
      }
    }
  ],
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "url": { "type": "string", "pattern": "^https://[^\\s/]+(?:[/?#][^\\s]*)?$" },
    "path": { "type": "string", "pattern": "^media/(?:[A-Za-z0-9_-]+/)+[A-Za-z0-9_-]+\\.(?:jpg|jpeg|png|webp)$" },
    "photo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "alt"],
      "properties": {
        "src": { "$ref": "#/$defs/path" },
        "thumbnail": { "$ref": "#/$defs/path" },
        "alt": { "$ref": "#/$defs/text" },
        "caption": { "$ref": "#/$defs/text" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
