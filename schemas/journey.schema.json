{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://higormflima.github.io/odisseiamundana/schemas/journey.schema.json",
  "title": "Metadados de viagem — rascunho 0.2",
  "description": "Contrato provisório para os metadados de uma viagem, expandido com participantes, transporte, hospedagem, atividades, orçamento e coordenadas.",
  "type": "object",
  "required": ["journey_id"],
  "additionalProperties": false,
  "properties": {
    "journey_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Identificador estável da viagem, escrito em inglês.",
      "examples": ["finland-2026"]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Título da viagem em português brasileiro."
    },
    "dates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "year": { "type": "integer", "minimum": 1900, "maximum": 2200 },
        "month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "start_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "end_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "geography": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "countries": { "type": "array", "items": { "type": "string" } },
        "regions": { "type": "array", "items": { "type": "string" } },
        "destinations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "duration_days": { "type": "integer", "minimum": 1 },
    "duration_nights": { "type": "integer", "minimum": 0 },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "notes": { "type": "string" }
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flights": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "route": {
                "type": "array",
                "minItems": 2,
                "items": { "type": "string", "minLength": 1 }
              },
              "cost_eur_per_person": { "type": "number", "minimum": 0 },
              "extra_baggage_eur": { "type": "number", "minimum": 0 },
              "notes": { "type": "string" }
            }
          }
        },
        "car_rental": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cost_eur": { "type": "number", "minimum": 0 },
            "days": { "type": "integer", "minimum": 1 },
            "fuel_eur_approx": { "type": "number", "minimum": 0 },
            "notes": { "type": "string" }
          }
        }
      }
    },
    "accommodation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": ["cabin", "hotel", "resort", "apartment", "other"]
          },
          "cost_eur": { "type": "number", "minimum": 0 },
          "nights": { "type": "integer", "minimum": 0 },
          "map_url": { "type": "string", "minLength": 1 },
          "coordinates": { "$ref": "#/$defs/coordinates" },
          "notes": { "type": "string" }
        }
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["activity_id", "name"],
        "additionalProperties": false,
        "properties": {
          "activity_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": { "type": "string", "minLength": 1 },
          "provider": { "type": "string" },
          "cost_eur": { "type": "number", "minimum": 0 },
          "cost_eur_per_person": { "type": "number", "minimum": 0 },
          "duration_minutes": { "type": "integer", "minimum": 1 },
          "map_url": { "type": "string", "minLength": 1 },
          "coordinates": { "$ref": "#/$defs/coordinates" },
          "notes": { "type": "string" }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": { "type": "string", "minLength": 1 },
        "grocery_eur": { "type": "number", "minimum": 0 },
        "total_eur_approx": { "type": "number", "minimum": 0 },
        "party_size": { "type": "integer", "minimum": 1 },
        "notes": { "type": "string" }
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_type", "verification_status"],
        "additionalProperties": false,
        "properties": {
          "source_type": {
            "type": "string",
            "enum": ["manual", "transcript", "youtube_metadata", "external_source", "ai_inference"]
          },
          "verification_status": {
            "type": "string",
            "enum": ["unverified", "reviewed", "confirmed"]
          },
          "source_id": { "type": "string" },
          "fields": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lng"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    }
  }
}
