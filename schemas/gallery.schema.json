{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Registro técnico de fotografias",
  "type": "object",
  "additionalProperties": false,
  "required": ["collection_id", "photos"],
  "properties": {
    "collection_id": { "$ref": "#/$defs/id" },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_hash", "width", "height", "variants"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "source_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "captured_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$" },
          "variants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["src", "format", "width", "height", "bytes"],
              "properties": {
                "src": { "type": "string", "pattern": "^media/gallery/[a-z0-9/-]+\\.(webp|jpg)$" },
                "format": { "enum": ["webp", "jpeg"] },
                "width": { "type": "integer", "minimum": 1 },
                "height": { "type": "integer", "minimum": 1 },
                "bytes": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "overrides": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "country": { "type": "string", "minLength": 1 },
              "region": { "type": "string", "minLength": 1 },
              "city": { "type": "string", "minLength": 1 },
              "alt": { "type": "string", "minLength": 1 },
              "featured": { "type": "boolean" }
            }
          }
        }
      }
    }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } }
}
