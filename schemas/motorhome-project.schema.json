{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odisseiamundana.com/schemas/motorhome-project.schema.json",
  "title": "Metadados de projeto de motorhome — rascunho 0.6",
  "description": "Contrato independente para construção, conversão ou melhorias de motorhomes. Não controla publicação.",
  "type": "object",
  "required": ["project_id"],
  "additionalProperties": false,
  "properties": {
    "project_id": { "$ref": "#/$defs/id" },
    "title": { "$ref": "#/$defs/text" },
    "summary": { "$ref": "#/$defs/text" },
    "vehicle_model": { "$ref": "#/$defs/text" },
    "chassis": { "$ref": "#/$defs/text" },
    "build_location": { "$ref": "#/$defs/text" },
    "representative_point": {
      "type": "object",
      "description": "Ponto representativo público do projeto, usado no mapa; não representa necessariamente o endereço da construção.",
      "required": ["name", "coordinates"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "coordinates": {
          "type": "object",
          "required": ["lat", "lng"],
          "additionalProperties": false,
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lng": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        }
      }
    },
    "build_period": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "start": { "$ref": "#/$defs/partialDate" },
        "end": { "$ref": "#/$defs/partialDate" }
      }
    },
    "main_costs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "amount", "currency", "unit"],
        "additionalProperties": false,
        "properties": {
          "description": { "$ref": "#/$defs/text" },
          "amount": { "type": "number", "minimum": 0 },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "unit": { "$ref": "#/$defs/text" },
          "approximate": { "type": "boolean" },
          "system_id": { "$ref": "#/$defs/id" },
          "video_ids": { "$ref": "#/$defs/videoIds" }
        }
      }
    },
    "cost_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_row", "description", "quantity", "amount", "currency"],
        "dependentRequired": { "allocation_uncertain": ["system_ids"] },
        "additionalProperties": false,
        "properties": {
          "source_row": { "type": "integer", "minimum": 1 },
          "description": { "$ref": "#/$defs/text" },
          "category": { "$ref": "#/$defs/text" },
          "detail": { "$ref": "#/$defs/text" },
          "quantity": { "type": "number", "exclusiveMinimum": 0 },
          "unit": { "$ref": "#/$defs/text" },
          "unit_price": { "type": "number", "minimum": 0 },
          "shipping": { "type": "number" },
          "amount": { "type": "number" },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "allocation_uncertain": {
            "type": "boolean",
            "description": "A aplicação da compra não está individualizada na fonte. Associação temática provisória autorizada pelo proprietário; exibir no final da tabela da etapa."
          },
          "system_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["photo_id", "src", "alt"],
        "additionalProperties": false,
        "properties": {
          "photo_id": { "$ref": "#/$defs/id" },
          "src": { "$ref": "#/$defs/mediaPath" },
          "thumbnail": { "$ref": "#/$defs/mediaPath" },
          "alt": { "$ref": "#/$defs/text" },
          "caption": { "$ref": "#/$defs/text" },
          "stage": { "$ref": "#/$defs/text" },
          "detail": { "$ref": "#/$defs/text" },
          "system_id": { "$ref": "#/$defs/id" }
        }
      }
    },
    "videos": {
      "type": "array",
      "description": "Referências, não cópias dos metadados originais dos vídeos.",
      "items": {
        "type": "object",
        "required": ["video_id", "youtube_url"],
        "additionalProperties": false,
        "properties": {
          "video_id": { "$ref": "#/$defs/videoId" },
          "youtube_url": {
            "type": "string",
            "pattern": "^https://www\\.youtube\\.com/watch\\?v=[A-Za-z0-9_-]{11}$"
          }
        }
      }
    },
    "playlist_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "playlist_order": {
      "$ref": "#/$defs/videoIds",
      "description": "IDs na ordem da playlist de origem: o índice 0 corresponde à posição 1. Não ordenar por data ou tema."
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["system_id", "title"],
        "additionalProperties": false,
        "properties": {
          "system_id": { "$ref": "#/$defs/id" },
          "title": { "$ref": "#/$defs/text" },
          "summary": { "$ref": "#/$defs/text" },
          "video_ids": { "$ref": "#/$defs/videoIds" },
          "materials": { "$ref": "#/$defs/textList" },
          "equipment": { "$ref": "#/$defs/textList" },
          "tools": { "$ref": "#/$defs/textList" },
          "technologies": { "$ref": "#/$defs/textList" },
          "processes": { "$ref": "#/$defs/textList" },
          "precautions": { "$ref": "#/$defs/textList" }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["solution"],
        "additionalProperties": false,
        "properties": {
          "solution": { "$ref": "#/$defs/text" },
          "reason": { "$ref": "#/$defs/text" },
          "system_id": { "$ref": "#/$defs/id" },
          "video_ids": { "$ref": "#/$defs/videoIds" }
        }
      }
    },
    "tips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description"],
        "additionalProperties": false,
        "properties": {
          "description": { "$ref": "#/$defs/text" },
          "system_id": { "$ref": "#/$defs/id" },
          "video_ids": { "$ref": "#/$defs/videoIds" }
        }
      }
    },
    "duration": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "value", "unit"],
        "additionalProperties": false,
        "properties": {
          "description": { "$ref": "#/$defs/text" },
          "value": { "type": "number", "exclusiveMinimum": 0 },
          "unit": { "enum": ["minutes", "hours", "days", "weeks", "months", "years"] },
          "approximate": { "type": "boolean" },
          "system_id": { "$ref": "#/$defs/id" },
          "video_ids": { "$ref": "#/$defs/videoIds" }
        }
      }
    },
    "before_after": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "before", "after"],
        "additionalProperties": false,
        "properties": {
          "title": { "$ref": "#/$defs/text" },
          "before": { "$ref": "#/$defs/comparisonState" },
          "after": { "$ref": "#/$defs/comparisonState" },
          "system_id": { "$ref": "#/$defs/id" },
          "video_ids": { "$ref": "#/$defs/videoIds" }
        }
      }
    },
    "notes": { "$ref": "#/$defs/text" },
    "downloads": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Cópias de planilhas autorizadas para download; caminhos relativos ao diretório public, sem barra inicial.",
      "items": {
        "type": "object",
        "required": ["title", "path"],
        "additionalProperties": false,
        "properties": {
          "title": { "$ref": "#/$defs/text" },
          "path": {
            "type": "string",
            "pattern": "^downloads/motorhome-projects/[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*\\.xlsx$"
          }
        }
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_type", "verification_status", "source_id", "fields"],
        "additionalProperties": false,
        "properties": {
          "source_type": {
            "enum": ["manual", "transcript", "youtube_metadata", "external_source", "ai_inference"]
          },
          "verification_status": { "enum": ["unverified", "reviewed", "confirmed"] },
          "source_id": { "$ref": "#/$defs/text" },
          "fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/text" }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "textList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "partialDate": {
      "type": "string",
      "pattern": "^[0-9]{4}(?:-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12][0-9]|3[01]))?)?$",
      "description": "AAAA, AAAA-MM ou AAAA-MM-DD; omitir o limite desconhecido. Nunca usar a publicação do vídeo como data da construção."
    },
    "videoId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
    "videoIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/videoId" }
    },
    "mediaPath": {
      "type": "string",
      "pattern": "^media/(?:[A-Za-z0-9_-]+/)+[A-Za-z0-9_-]+\\.(?:jpg|jpeg|png|webp)$"
    },
    "comparisonState": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "description": { "$ref": "#/$defs/text" },
        "photo_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    }
  }
}
